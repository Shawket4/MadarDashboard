{
  "name": "madar-downloads",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Madar downloads (downloads.madar-pos.cloud): Astro, EN/AR, baked from manifest.json",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/prebuild.mjs && astro dev --port 5185",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "astro build",
    "preview": "astro preview --port 5195",
    "manifest": "node scripts/manifest.mjs",
    "test": "node scripts/manifest.test.mjs",
    "verify": "node scripts/verify.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^6.4.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.7"
  }
}
