---
import { t, type Lang } from "@/lib/i18n";
const { lang } = Astro.props as { lang: Lang };
const c = t(lang);
---
<header class="top">
  <div class="wrap top-in">
    <a class="brand" href="https://madar-pos.cloud/" aria-label="Madar">
      <img src="/favicon.svg" width="28" height="28" alt="" />
      <span class="brand-name">{lang === "ar" ? "مدار" : "Madar"}</span>
    </a>
    <nav class="top-nav" aria-label="Language">
      <a class="lang" href={c.otherHref} hreflang={lang === "ar" ? "en" : "ar"} lang={lang === "ar" ? "en" : "ar"}>{c.otherLang}</a>
    </nav>
  </div>
  <div class="wrap hero">
    <p class="kicker">{c.kicker}</p>
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
  </div>
</header>
