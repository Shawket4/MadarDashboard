{
  "entry": [
    "src/main.tsx",
    "src/order/main.tsx",
    "src/loyalty/main.tsx",
    "src/reservations/main.tsx",
    "scripts/**/*.mjs",
    "src/data/api/mock/enable*.ts",
    "orval.config.ts"
  ],
  "ignorePatterns": [
    ".github/**",
    "site/**",
    "downloads/**",
    "dist/**",
    "dist-demo/**",
    "src/data/api/generated/**",
    "*.cjs"
  ],
  "ignoreDependencies": [
    "@faker-js/faker",
    "@tanstack/react-query-devtools"
  ],
  "ignoreExports": [
    {
      "file": "src/generated/**",
      "exports": [
        "*"
      ]
    },
    {
      "file": "shared/**",
      "exports": [
        "*"
      ]
    },
    {
      "file": "src/data/api/custom-instance.ts",
      "exports": [
        "default"
      ]
    },
    {
      "file": "src/lib/rules/wasm/**",
      "exports": [
        "*"
      ]
    },
    {
      "file": "src/lib/motion/**",
      "exports": [
        "*"
      ]
    }
  ]
}
