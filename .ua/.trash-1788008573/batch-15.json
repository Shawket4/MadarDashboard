{
  "nodes": [
    {"id":"file:src/features/integrations/handoff-content.ts","type":"file","name":"handoff-content.ts","filePath":"src/features/integrations/handoff-content.ts","summary":"Generates the English-only, CRLF plain-text files (credentials and README integration spec) that go inside the encrypted partner credential handoff archive, plus the OS-safe zip filename.","tags":["utility","integrations","text-generation","credential-handoff"],"complexity":"complex","languageNotes":"Deliberately bypasses i18n because the reader is the partner's engineer, not the dashboard operator; uses CRLF without BOM for Windows Notepad compatibility."},
    {"id":"function:src/features/integrations/handoff-content.ts:handoffFilename","type":"function","name":"handoffFilename","filePath":"src/features/integrations/handoff-content.ts","lineRange":[44,47],"summary":"Builds a filename-safe, dated archive name from the slugged partner username.","tags":["utility","filename","slug"],"complexity":"simple"},
    {"id":"function:src/features/integrations/handoff-content.ts:credentialsText","type":"function","name":"credentialsText","filePath":"src/features/integrations/handoff-content.ts","lineRange":[49,79],"summary":"Renders the credentials.txt body containing the username, secret, Basic auth header and analytics URL for the partner.","tags":["text-generation","credentials","integrations"],"complexity":"simple"},
    {"id":"function:src/features/integrations/handoff-content.ts:readmeText","type":"function","name":"readmeText","filePath":"src/features/integrations/handoff-content.ts","lineRange":[81,225],"summary":"Renders the long-form README integration specification describing how the partner should use the issued credentials.","tags":["text-generation","documentation","integrations"],"complexity":"moderate"},
    {"id":"function:src/features/integrations/handoff-content.ts:buildHandoffFiles","type":"function","name":"buildHandoffFiles","filePath":"src/features/integrations/handoff-content.ts","lineRange":[227,232],"summary":"Exported entry point returning the list of HandoffFile entries (credentials and README) for a HandoffInput.","tags":["factory","integrations","credential-handoff"],"complexity":"simple"},
    {"id":"file:src/features/integrations/handoff-zip.ts","type":"file","name":"handoff-zip.ts","filePath":"src/features/integrations/handoff-zip.ts","summary":"Builds the AES-256 (WinZip AE-2) encrypted handoff zip using a lazily imported zip.js core with web workers disabled for Tauri/WebKit CSP safety.","tags":["utility","encryption","zip","integrations"],"complexity":"moderate","languageNotes":"Dynamic import() keeps zip.js out of the entry bundle; workers disabled because Tauri CSP allows worker-src blob: but not script-src blob:."},
    {"id":"function:src/features/integrations/handoff-zip.ts:buildEncryptedHandoffZip","type":"function","name":"buildEncryptedHandoffZip","filePath":"src/features/integrations/handoff-zip.ts","lineRange":[41,61],"summary":"Writes the handoff text files into a password-protected AES-256 zip blob, explicitly refusing legacy ZipCrypto.","tags":["encryption","zip","async"],"complexity":"simple"},
    {"id":"file:src/features/integrations/passphrase.ts","type":"file","name":"passphrase.ts","filePath":"src/features/integrations/passphrase.ts","summary":"Generates dictation-friendly 20-symbol passphrases (XXXX-XXXX-XXXX-XXXX-XXXX) from a 31-symbol confusable-free alphabet using the Web Crypto CSPRNG with rejection sampling.","tags":["utility","security","random","credential-handoff"],"complexity":"moderate","languageNotes":"Uses rejection sampling above 248 to avoid modulo bias; throws InsecureRandomError rather than falling back to Math.random()."},
    {"id":"class:src/features/integrations/passphrase.ts:InsecureRandomError","type":"class","name":"InsecureRandomError","filePath":"src/features/integrations/passphrase.ts","lineRange":[26,31],"summary":"Error thrown when the platform provides no cryptographically secure random source.","tags":["error","security","type-definition"],"complexity":"simple"},
    {"id":"function:src/features/integrations/passphrase.ts:hasSecureRandom","type":"function","name":"hasSecureRandom","filePath":"src/features/integrations/passphrase.ts","lineRange":[42,44],"summary":"Pre-flight check for availability of crypto.getRandomValues.","tags":["utility","security","feature-detection"],"complexity":"simple"},
    {"id":"function:src/features/integrations/passphrase.ts:generatePassphrase","type":"function","name":"generatePassphrase","filePath":"src/features/integrations/passphrase.ts","lineRange":[56,74],"summary":"Produces a grouped 20-symbol passphrase using an injectable random byte source and modulo-bias-free rejection sampling.","tags":["security","random","passphrase"],"complexity":"simple"},
    {"id":"file:src/features/integrations/use-credential-handoff.ts","type":"file","name":"use-credential-handoff.ts","filePath":"src/features/integrations/use-credential-handoff.ts","summary":"React hook orchestrating the credential handoff: generates a passphrase, builds the encrypted zip from an issued credential, triggers the download and exposes status, retry and download-again controls.","tags":["hook","integrations","credential-handoff","state-management"],"complexity":"moderate"},
    {"id":"function:src/features/integrations/use-credential-handoff.ts:useCredentialHandoff","type":"function","name":"useCredentialHandoff","filePath":"src/features/integrations/use-credential-handoff.ts","lineRange":[33,103],"summary":"Hook that auto-builds and downloads the encrypted handoff archive on mount, tracking building/ready/failed status and download count.","tags":["hook","async","integrations"],"complexity":"moderate"},
    {"id":"file:src/lib/download.ts","type":"file","name":"download.ts","filePath":"src/lib/download.ts","summary":"Shared browser file-download helpers that attach the anchor to the document before clicking and defer object URL revocation to avoid Firefox and WebKit races.","tags":["utility","browser","download"],"complexity":"simple","languageNotes":"Revokes object URLs after a 60s delay because synchronous revocation yields zero-byte downloads in WebKit (Tauri macOS webview)."},
    {"id":"function:src/lib/download.ts:downloadUrl","type":"function","name":"downloadUrl","filePath":"src/lib/download.ts","lineRange":[23,32],"summary":"Downloads an already-addressable URL via a temporarily attached anchor element.","tags":["utility","browser","download"],"complexity":"simple"},
    {"id":"function:src/lib/download.ts:downloadBlob","type":"function","name":"downloadBlob","filePath":"src/lib/download.ts","lineRange":[35,39],"summary":"Creates an object URL for a blob, downloads it and revokes the URL after a safe delay.","tags":["utility","browser","blob"],"complexity":"simple"}
