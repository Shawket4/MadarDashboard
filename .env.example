# Copy to .env for local dev. The dashboard talks to the dedicated API origin
# (api.madar-pos.cloud); the main madar-pos.cloud vhost no longer proxies /api.
# For local backend dev, point VITE_API_URL at http://localhost:8082 instead.
VITE_API_URL=https://api.madar-pos.cloud

# Origin of the management dashboard — used by the standalone landing
# (get.madar-pos.cloud) for its cross-origin "Sign in" / "Get started" links.
VITE_DASHBOARD_URL=https://madar-pos.cloud

# ── Sentry (self-hosted: https://sentry.madar-pos.cloud) ──────────────────────
# Leave VITE_SENTRY_DSN unset/blank to disable Sentry completely — the app runs
# normally, nothing is initialised and nothing is sent.
VITE_SENTRY_DSN=https://f4aeabcb758c4cd1d1d12d5f5ee2a46c@sentry.madar-pos.cloud/2

# Optional overrides (all have sane defaults):
#   VITE_SENTRY_ENVIRONMENT   defaults to the Vite mode (development/production)
#   VITE_SENTRY_RELEASE       defaults to madar-dashboard@<package.json version>
#   VITE_SENTRY_TRACES_SAMPLE_RATE                 default 0.1
#   VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE        default 0.1
#   VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE       default 1.0
#
# Session Replay is enabled with maskAllText + maskAllInputs + blockAllMedia,
# because the DOM carries customer PII (names, phones, delivery addresses) and
# staff payroll figures. Do not relax that — see src/lib/sentry.ts.
#
# Source maps: build-time only, NOT Vite vars — set these in CI (never commit
# the token). When all three are present, `npm run build` emits hidden source
# maps, uploads them to Sentry and deletes them from dist/:
#   SENTRY_AUTH_TOKEN=<org auth token with project:releases scope>
#   SENTRY_ORG=<sentry org slug>
#   SENTRY_PROJECT=<sentry project slug>
#   SENTRY_URL=https://sentry.madar-pos.cloud   # optional, this is the default
