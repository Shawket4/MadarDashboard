---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Shot from "@/components/media/Shot.astro";
import Words from "@/components/kit/Words.astro";
import Icon from "@/components/ui/Icon.astro";
import Orbit from "@/components/ui/Orbit.astro";
import StoreBadges from "@/components/ui/StoreBadges.astro";
import cashier from "@/assets/apps/cashier.svg?url";
import CrewBadge from "@/components/free/CrewBadge.astro";
import Nuqta from "@/components/free/Nuqta.astro";
import NuqtaCup from "@/components/free/NuqtaCup.astro";
import NuqtaCount from "@/components/free/NuqtaCount.astro";
import Shariha from "@/components/free/Shariha.astro";
import ZReport from "@/components/free/ZReport.astro";
import { t } from "@/i18n";
import { type Lang, LANGS, CASHIER_APK_URL, pageHref, signupHref, whatsappHref } from "@/lib/site";
import { breadcrumbs } from "@/lib/schema";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const c = t(lang);
const f = c.freePage;
const signup = signupHref(lang);
/** "0 EGP" → the figure (Plex Mono) and its currency (the page's face: Arabic breaks in Mono). */
const money = (s: string) => { const [n, ...cur] = s.split(" "); return { n, cur: cur.join(" ") }; };
const tablePrice = money(f.compare.freePrice);
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: f.faq.items.map((i) => ({ "@type": "Question", name: i.q, acceptedAnswer: { "@type": "Answer", text: i.a } })),
}, breadcrumbs(lang, "free")];
---
<BaseLayout
  lang={lang}
  page="free"
  headerTone="ink"
  closing={false}
  jsonLd={jsonLd}
  sticky={{ href: signup, label: f.stickyCta, event: "free-signup" }}
>
  <!-- The offer, and the till it buys: Madar Cashier, with what Free costs pinned to it. -->
  <section class="on-ink relative isolate overflow-hidden bg-ink text-paper" aria-labelledby="free-title">
    <Orbit tone="ink" class="absolute -end-[34rem] -top-[30rem] -z-10 h-[78rem] w-[78rem] md:-end-[22rem]" />
    <div class="container-site grid items-center gap-16 pb-24 pt-32 md:pt-36 lg:grid-cols-12 lg:gap-10 lg:pb-32 lg:pt-40">
      <div class="relative lg:col-span-6">
        <!-- On a phone the badge hangs beside the headline, in the first screen (the one
             over the till, below, is for wider screens). -->
        <CrewBadge lang={lang} who="nuqta" strap="teal" class="free-hero-badge-m" />
        <p class="kicker text-teal-light" data-intro style="--i:0">{f.kicker}</p>
        <h1 id="free-title" class="text-display mt-6"><Words text={f.title} /></h1>
        <p class="free-hero-sub text-lead mt-6 max-w-xl text-muted-ink" data-intro style="--i:1">{f.sub}</p>
        <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3" data-intro style="--i:2">
          <a class="btn btn-paper btn-lg" href={signup} data-umami-event="free-signup" data-umami-event-where="free-hero">
            {f.cta} <Icon name="arrow" size={18} />
          </a>
          <a class="link-cta" href="#included">{f.secondary} <Icon name="arrow-down" size={18} /></a>
        </div>
        <p class="mt-7 flex max-w-md items-start gap-2.5 text-sm text-muted-ink" data-intro style="--i:3">
          <span class="mt-0.5 text-teal-light"><Icon name="clock" size={18} /></span>
          <span>{f.note}</span>
        </p>
      </div>

      <div class="free-hero-media relative lg:col-span-6" data-hero-media>
        <div class="relative mx-auto max-w-[40rem] lg:ms-[6%]">
          <Shot
            id="pos-cart"
            lang={lang}
            alt={f.altPos}
            frame="ipad"
            eager
            sizes="(min-width: 1280px) 600px, (min-width: 1024px) 46vw, 92vw"
            data-hero-ipad=""
          />
          <!-- نقطة's crew badge, hanging over the till: "Salary: 0 EGP" is the offer. -->
          <CrewBadge lang={lang} who="nuqta" strap="teal" class="free-hero-badge" />
        </div>
      </div>
    </div>
  </section>

  <!-- What Free carries, as the crew it hires (the owner's "New crew" posters): نقطة on
       the till, شريحة on the numbers. Then the till close, printed; then the limits. -->
  <section id="included" class="bg-paper" aria-labelledby="inc-title">
    <div class="container-site py-20 md:py-28">
      <div class="max-w-3xl">
        <p class="kicker text-teal" data-reveal>{f.included.kicker}</p>
        <h2 id="inc-title" class="text-h2 mt-4" data-split>{f.included.title}</h2>
        <p class="text-lead mt-5 text-muted" data-reveal>{f.included.lead}</p>
      </div>
      <div class="mt-16 grid gap-16 md:grid-cols-2 md:gap-12 lg:gap-20" data-reveal-group>
        {(["nuqta", "shariha"] as const).map((who, col) => (
          <div class="crew-col" data-reveal>
            <div class="crew-col-head" data-crew-host>
              {who === "nuqta" ? <Nuqta class="crew-col-figure" /> : <Shariha class="crew-col-figure" />}
              <div class="crew-col-who">
                <h3 class="crew-col-name">{f.crew[who].name}</h3>
                <p class="crew-col-role">{f.crew[who].role}</p>
                <p class="crew-salary">{f.crew.salary}</p>
              </div>
            </div>
            <ul class="crew-col-items">
              {f.included.items.slice(col * 3, col * 3 + 3).map((i) => (
                <li>
                  <span class="free-tick" aria-hidden="true"><Icon name="check" size={16} /></span>
                  <h4 class="font-semibold leading-snug">{i.t}</h4>
                  <p class="mt-1.5 text-muted">{i.b}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-24 grid items-center gap-12 md:mt-32 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="kicker text-teal" data-reveal>{f.zr.kicker}</p>
          <h3 class="text-h3 mt-4" data-split>{f.zr.title}</h3>
          <p class="text-lead mt-5 text-muted" data-reveal>{f.zr.body}</p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <div class="zr-scene" data-crew-host>
            <NuqtaCount class="zr-nuqta" />
            <ZReport lang={lang} />
          </div>
        </div>
      </div>

      <div class="free-limits mt-24" data-reveal>
        <h3 class="font-semibold">{f.included.limitsTitle}</h3>
        <p class="text-muted">{f.included.limits}</p>
        <a class="link-cta shrink-0" href="#compare">{f.compare.title.replace(/[.؟?]$/, "")} <Icon name="arrow-down" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- Free beside the paid plans, row by row: a feature is in Free whole, or not at all. -->
  <section id="compare" class="bg-surface" aria-labelledby="cmp-title">
    <div class="container-site py-20 md:py-28">
      <div class="max-w-3xl">
        <p class="kicker text-teal" data-reveal>{f.compare.kicker}</p>
        <h2 id="cmp-title" class="text-h2 mt-4" data-split>{f.compare.title}</h2>
        <p class="text-lead mt-5 text-muted" data-reveal>{f.compare.sub}</p>
      </div>
      <div class="card mt-12 overflow-hidden" data-reveal>
        <table class="free-table">
          <caption class="sr-only">{f.compare.title}</caption>
          <thead>
            <tr>
              <td></td>
              <th scope="col" class="free-col">
                <span class="block">{f.compare.free}</span>
                <span class="free-table-price"><span class="ltr">{tablePrice.n}</span> <span class="free-cur">{tablePrice.cur}</span></span>
              </th>
              <th scope="col">
                <span class="block">{f.compare.paid}</span>
                <span class="free-table-note">{f.compare.paidPrice}</span>
              </th>
            </tr>
          </thead>
          {f.compare.groups.map((g) => (
            <tbody>
              <tr class="free-table-group"><th scope="rowgroup">{g.title}</th><td class="free-col"></td><td></td></tr>
              {g.rows.map((r) => (
                <tr>
                  <th scope="row">{r.t}</th>
                  <td class="free-col">
                    {typeof r.free === "string" ? <span class="free-table-value ltr">{r.free}</span>
                      : r.free ? <Fragment><span class="text-teal"><Icon name="check" size={18} /></span><span class="sr-only">{f.compare.yes}</span></Fragment>
                      : <Fragment><span class="text-slate" aria-hidden="true">–</span><span class="sr-only">{f.compare.no}</span></Fragment>}
                  </td>
                  <td>
                    {"paid" in r ? <span class="free-table-value">{r.paid}</span>
                      : <Fragment><span class="text-teal"><Icon name="check" size={18} /></span><span class="sr-only">{f.compare.yes}</span></Fragment>}
                  </td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
      <p class="mt-8" data-reveal>
        <a class="link-cta" href={pageHref(lang, "pricing")} data-umami-event="free-upgrade" data-umami-event-where="free-compare">{f.compare.more} <Icon name="arrow" size={18} /></a>
      </p>
    </div>
  </section>

  <!-- Sign-up to first order. The till app sits in its step, with both ways to get it. -->
  <section class="bg-paper" aria-labelledby="steps-title">
    <div class="container-site py-20 md:py-28">
      <div class="max-w-3xl">
        <p class="kicker text-teal" data-reveal>{f.steps.kicker}</p>
        <h2 id="steps-title" class="text-h2 mt-4" data-split>{f.steps.title}</h2>
      </div>
      <ol class="free-steps mt-14" data-reveal-group>
        {f.steps.items.map((s, i) => (
          <li class="free-step" data-reveal>
            <span class="free-step-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-5 text-lg font-semibold leading-snug">{s.t}</h3>
            <p class="mt-2 text-muted">{s.b}</p>
            {i === 0 && (
              <a class="link-cta mt-3" href={signup} data-umami-event="free-signup" data-umami-event-where="free-steps">{f.cta} <Icon name="arrow" size={18} /></a>
            )}
            {i === 1 && (
              <div class="mt-5 grid gap-4">
                <div class="flex items-center gap-3">
                  <img class="app-icon size-11" src={cashier} width="44" height="44" alt="" />
                  <StoreBadges lang={lang} app="cashier" where="free-steps" />
                </div>
                {CASHIER_APK_URL ? (
                  <div>
                    <a class="btn btn-outline" href={CASHIER_APK_URL} data-umami-event="android-apk" data-umami-event-where="free-steps">
                      <Icon name="arrow-down" size={18} /> {f.steps.apk}
                    </a>
                    <p class="mt-2 text-xs text-muted">{f.steps.apkNote}</p>
                  </div>
                ) : (
                  <a class="link-cta !min-h-0 text-sm" href={whatsappHref(lang, f.steps.waAndroid)} target="_blank" rel="noopener" data-umami-event="whatsapp" data-umami-event-where="free-android">
                    <Icon name="whatsapp" size={16} /> {f.steps.askAndroid}
                  </a>
                )}
              </div>
            )}
          </li>
        ))}
      </ol>
      <p class="mt-12 flex max-w-2xl items-start gap-2.5 text-muted" data-reveal>
        <span class="mt-0.5 text-teal"><Icon name="check" size={18} /></span>
        <span>{f.steps.need}</span>
      </p>
    </div>
  </section>

  <section class="bg-paper" aria-labelledby="free-faq-title">
    <div class="container-site"><div class="grid gap-10 border-t border-rule pb-24 pt-20 md:pb-32 md:pt-28 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2 id="free-faq-title" class="text-h3" data-split>{f.faq.kicker}</h2>
      </div>
      <div class="lg:col-span-8">
        <div class="divide-y divide-ink/10 border-y border-ink/10" data-reveal-group>
          {f.faq.items.map((item, i) => (
            <details class="faq-item group" open={i === 0} data-reveal>
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-lg font-semibold leading-snug marker:hidden [&::-webkit-details-marker]:hidden">
                <span>{item.q}</span>
                <span class="mt-1 grid h-7 w-7 shrink-0 place-items-center rounded-full border border-rule text-teal transition-transform duration-300 group-open:rotate-45">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                </span>
              </summary>
              <p class="max-w-2xl pb-7 text-muted">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div></div>
  </section>

  <!-- The two doors (owner, 2026-10-14): Free, set up yourself; or a paid plan we set up
       with you, its first month on us. -->
  <section id="closing" class="on-ink relative isolate overflow-hidden bg-ink text-paper" aria-labelledby="doors-title">
    <Orbit tone="ink" class="absolute -end-[28rem] top-1/2 -z-10 h-[64rem] w-[64rem] -translate-y-1/2 md:-end-[20rem]" />
    <div class="container-site py-24 md:py-32">
      <div class="max-w-3xl">
        <p class="kicker text-teal-light" data-reveal>{f.doors.kicker}</p>
        <h2 id="doors-title" class="text-h2 mt-4" data-split>{f.doors.title}</h2>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-2 md:gap-5" data-reveal-group>
        <div class="free-door free-door-main" data-reveal>
          <div class="free-door-roundel" data-crew-host><NuqtaCup class="free-door-cup" /></div>
          <p class="free-door-tag">{f.doors.self.tag}</p>
          <h3 class="text-h3 mt-4">{f.doors.self.title}</h3>
          <p class="mt-3 max-w-md text-muted-ink">{f.doors.self.body}</p>
          <div class="mt-auto pt-8">
            <a class="btn btn-paper btn-lg" href={signup} data-umami-event="free-signup" data-umami-event-where="free-closing">
              {f.doors.self.cta} <Icon name="arrow" size={18} />
            </a>
            <p class="mt-3 text-sm text-muted-ink">{f.doors.self.note}</p>
          </div>
        </div>
        <div class="free-door" data-reveal>
          <p class="free-door-tag">{f.doors.assisted.tag}</p>
          <h3 class="text-h3 mt-4">{f.doors.assisted.title}</h3>
          <p class="mt-3 max-w-md text-muted-ink">{f.doors.assisted.body}</p>
          <div class="mt-auto pt-8">
            <a class="btn btn-ghost-ink btn-lg" href={whatsappHref(lang)} target="_blank" rel="noopener" data-umami-event="free-month" data-umami-event-where="free-closing">
              <Icon name="whatsapp" size={18} /> {f.doors.assisted.cta}
            </a>
            <p class="mt-3 text-sm text-muted-ink">{f.doors.assisted.note}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import "@/scripts/crew";
</script>
