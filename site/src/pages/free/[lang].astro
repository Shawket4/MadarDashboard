---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Shot from "@/components/media/Shot.astro";
import Words from "@/components/kit/Words.astro";
import Section from "@/components/kit/Section.astro";
import PlanTable from "@/components/kit/PlanTable.astro";
import CtaBand from "@/components/kit/CtaBand.astro";
import FaqList from "@/components/kit/FaqList.astro";
import Icon from "@/components/ui/Icon.astro";
import Orbit from "@/components/ui/Orbit.astro";
import StoreBadges from "@/components/ui/StoreBadges.astro";
import cashier from "@/assets/apps/cashier.svg?url";
import CrewBadge from "@/components/free/CrewBadge.astro";
import ZReport from "@/components/free/ZReport.astro";
import CrewMoment from "@/components/kit/CrewMoment.astro";
import StepList from "@/components/kit/StepList.astro";
import FoodicsStage from "@/components/media/FoodicsStage.astro";
import { t } from "@/i18n";
import { type Lang, LANGS, downloadsHref, pageHref, signupHref, whatsappHref } from "@/lib/site";
import { breadcrumbs, faqPage, freeApplication } from "@/lib/schema";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const c = t(lang);
const f = c.freePage;
const signup = signupHref(lang);
const cmp = f.compare;
const groupIcons = ["receipt", "chart", "table", "team"] as const;
const jsonLd = [faqPage(lang, f.faq.items), freeApplication(lang), breadcrumbs(lang, "free")];
---
<BaseLayout
  lang={lang}
  page="free"
  headerTone="ink"
  closing={false}
  jsonLd={jsonLd}
  sticky={{ href: signup, label: f.stickyCta, event: "free-signup" }}
  headerCta={{ href: signup, label: f.stickyCta, event: "free-signup" }}
>
  <!-- The offer, and the till it buys: Madar Cashier, with what Free costs pinned to it. -->
  <section class="on-ink relative isolate overflow-hidden bg-ink text-paper" aria-labelledby="free-title" data-sequence="hero">
    <Orbit tone="ink" class="absolute -end-[34rem] -top-[30rem] -z-10 h-[78rem] w-[78rem] md:-end-[22rem]" />
    <div class="container-site grid items-center gap-12 pb-20 pt-32 md:gap-16 md:pb-24 md:pt-36 lg:grid-cols-12 lg:gap-10 lg:pb-32 lg:pt-40">
      <div class="relative lg:col-span-6" data-hero-copy>
        <!-- On a phone the badge hangs beside the headline, in the first screen (the one
             over the till, below, is for wider screens). -->
        <CrewBadge lang={lang} who="nuqta" strap="teal" class="free-hero-badge-m" />
        <p class="kicker text-teal-light" data-intro style="--i:0">{f.kicker}</p>
        <h1 id="free-title" class="text-display mt-6"><Words text={f.title} /></h1>
        <p class="free-hero-sub text-lead mt-6 max-w-xl text-muted-ink" data-intro style="--i:1">{f.sub}</p>
        <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3" data-intro style="--i:2">
          <a class="btn btn-paper btn-lg" href={signup} data-umami-event="free-signup" data-umami-event-where="free-hero">
            {f.cta} <Icon name="arrow" size={18} />
          </a>
          <a class="link-cta" href="#included">{f.secondary} <Icon name="arrow-down" size={18} /></a>
        </div>
        <p class="mt-7 flex max-w-md items-start gap-2.5 text-sm text-muted-ink" data-intro style="--i:3">
          <span class="mt-0.5 text-teal-light"><Icon name="clock" size={18} /></span>
          <span>{f.note}</span>
        </p>
      </div>

      <div class="free-hero-media relative lg:col-span-6" data-hero-media data-light="glow">
        <div class="relative mx-auto max-w-[40rem] lg:ms-[6%]">
          <Shot
            id="pos-cart"
            lang={lang}
            alt={f.altPos}
            frame="ipad"
            eager
            sizes="(min-width: 1280px) 600px, (min-width: 1024px) 46vw, 92vw"
            data-hero-ipad=""
          />
          <!-- نقطة's crew badge, hanging over the till: "Salary: 0 EGP" is the offer. -->
          <CrewBadge lang={lang} who="nuqta" strap="teal" class="free-hero-badge" />
        </div>
      </div>
    </div>
  </section>

  <!-- What Free carries, as the crew it hires (the owner's "New crew" posters): نقطة on
       the till, شريحة on the numbers. Then the till close, printed; then the limits. -->
  <Section id="included" titleId="inc-title" kicker={f.included.kicker} title={f.included.title} lead={f.included.lead}>
    <div class="grid gap-14 md:grid-cols-2 md:gap-12 lg:gap-20" data-reveal-group>
      {(["nuqta", "shariha"] as const).map((who, col) => (
        <div class="crew-col" data-reveal>
          <div class="crew-col-head" data-crew-host>
            <CrewMoment pose={who === "nuqta" ? "wave" : "slice"} class="crew-col-figure" />
            <div class="crew-col-who">
              <h3 class="crew-col-name">{f.crew[who].name}</h3>
              <p class="crew-col-role">{f.crew[who].role}</p>
              <p class="crew-salary">{f.crew.salary}</p>
            </div>
          </div>
          <ul class="crew-col-items">
            {f.included.items.slice(col * 3, col * 3 + 3).map((i) => (
              <li>
                <span class="free-tick" aria-hidden="true" data-pop><Icon name="check" size={16} draw /></span>
                <h4 class="font-semibold leading-snug">{i.t}</h4>
                <p class="mt-1.5 text-muted">{i.b}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-20 grid items-center gap-10 md:mt-32 md:gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="kicker text-teal" data-reveal>{f.zr.kicker}</p>
        <h3 class="text-h3 mt-4" data-split>{f.zr.title}</h3>
        <p class="text-lead mt-5 text-muted" data-reveal>{f.zr.body}</p>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <div class="zr-scene" data-crew-host>
          <CrewMoment pose="count" class="zr-nuqta" />
          <ZReport lang={lang} />
        </div>
      </div>
    </div>

    <!-- The crew cheering on the band's top edge (the owner's "Not a penny" poster). -->
    <CtaBand class="mt-24 md:mt-32" title={f.band} body={f.note} cta={{ href: signup, label: f.cta, event: "free-signup", where: "free-mid" }}>
      <Fragment slot="crew"><CrewMoment pose="slice-joy" class="cta-band-shariha" /><CrewMoment pose="joy" class="cta-band-nuqta" /></Fragment>
    </CtaBand>

    <div class="free-limits mt-16 md:mt-24" data-reveal>
      <h3 class="font-semibold">{f.included.limitsTitle}</h3>
      <p class="text-muted">{f.included.limits}</p>
      <a class="link-cta shrink-0" href="#compare">{cmp.title.replace(/[.؟?]$/, "")} <Icon name="arrow-down" size={18} /></a>
    </div>
  </Section>

  <!-- Free beside the paid plans: Free is a subset of paid, so every line is either in Free
       or added by paid (kit/PlanTable). -->
  <Section id="compare" titleId="cmp-title" tone="surface" kicker={cmp.kicker} title={cmp.title} lead={cmp.sub}>
    <PlanTable
      id="fc"
      columns={[cmp.free, cmp.paid]}
      plans={[{ name: cmp.free, size: cmp.freeSize, price: cmp.freePrice }, { name: cmp.paid, size: cmp.paidSize, price: cmp.paidPrice }]}
      groups={cmp.groups.map((g, i) => ({ ...g, icon: groupIcons[i] }))}
      adds={cmp.paidOnly}
      copy={{ inFirst: cmp.inFree, adds: cmp.adds, tag: cmp.paidTag }}
      more={{ href: pageHref(lang, "pricing"), label: cmp.more, event: "free-upgrade", where: "free-compare" }}
    >
      <CrewMoment slot="peek" pose="slice" class="pt-peek" />
    </PlanTable>
  </Section>

  <!-- Sign-up to first order. The till app sits in its step, with both ways to get it. -->
  <Section titleId="steps-title" kicker={f.steps.kicker} title={f.steps.title}>
    <StepList items={f.steps.items.map((s) => ({ title: s.t, body: s.b }))}>
      <a slot="step-0" class="link-cta mt-3" href={signup} data-umami-event="free-signup" data-umami-event-where="free-steps">{f.cta} <Icon name="arrow" size={18} /></a>
      <div slot="step-1" class="mt-5 grid gap-4">
        <div class="flex items-center gap-3">
          <img class="app-icon size-11" src={cashier} width="44" height="44" alt="" />
          <StoreBadges lang={lang} app="cashier" where="free-steps" />
        </div>
        <div>
          <a class="btn btn-outline" href={downloadsHref(lang, "cashier")} data-umami-event="downloads" data-umami-event-where="free-steps">
            <Icon name="arrow-down" size={18} /> {f.steps.apk}
          </a>
          <p class="mt-2 text-xs text-muted">{f.steps.apkNote}</p>
        </div>
      </div>
      <!-- Coming from Foodics: the import, short, with its scene played once; the home page
           has the five steps. -->
      <div slot="step-2" class="mt-5" data-foodics="play">
        <p class="text-sm text-muted"><span class="font-semibold text-ink">{f.steps.foodics.title}</span> {f.steps.foodics.body}</p>
        <FoodicsStage lang={lang} compact class="mt-4" />
        <a class="link-cta mt-1 text-sm" href={`${pageHref(lang, "home")}#foodics`} data-umami-event="foodics" data-umami-event-where="free-steps">{f.steps.foodics.link} <Icon name="arrow" size={16} /></a>
      </div>
    </StepList>
    <p class="mt-12 flex max-w-2xl items-start gap-2.5 text-muted" data-reveal>
      <span class="mt-0.5 text-teal"><Icon name="check" size={18} /></span>
      <span>{f.steps.need}</span>
    </p>
  </Section>

  <Section titleId="free-faq-title" title={f.faq.kicker} size="h3" split={4} rule>
    <FaqList items={f.faq.items} />
  </Section>

  <!-- The two doors (owner, 2026-10-14): Free, set up yourself; or a paid plan we set up
       with you, its first month on us. -->
  <Section
    id="closing"
    titleId="doors-title"
    tone="ink"
    pad="loose"
    orbit="-end-[28rem] top-1/2 h-[64rem] w-[64rem] -translate-y-1/2 md:-end-[20rem]"
    kicker={f.doors.kicker}
    title={f.doors.title}
  >
    <div class="grid gap-4 md:grid-cols-2 md:gap-5" data-reveal-group>
      <div class="free-door free-door-main" data-reveal>
        <CrewMoment pose="cup" class="free-door-cup" host="free-door-roundel" />
        <p class="free-door-tag">{f.doors.self.tag}</p>
        <h3 class="text-h3 mt-4">{f.doors.self.title}</h3>
        <p class="mt-3 max-w-md text-muted-ink">{f.doors.self.body}</p>
        <div class="mt-auto pt-8">
          <a class="btn btn-paper btn-lg" href={signup} data-umami-event="free-signup" data-umami-event-where="free-closing">
            {f.doors.self.cta} <Icon name="arrow" size={18} />
          </a>
          <p class="mt-3 text-sm text-muted-ink">{f.doors.self.note}</p>
        </div>
      </div>
      <div class="free-door" data-reveal>
        <CrewMoment pose="pot" class="free-door-kanaka" host="free-door-roundel free-door-roundel-ink" />
        <p class="free-door-tag">{f.doors.assisted.tag}</p>
        <h3 class="text-h3 mt-4">{f.doors.assisted.title}</h3>
        <p class="mt-3 max-w-md text-muted-ink">{f.doors.assisted.body}</p>
        <div class="mt-auto pt-8">
          <a class="btn btn-ghost-ink btn-lg" href={whatsappHref(lang)} target="_blank" rel="noopener" data-umami-event="free-month" data-umami-event-where="free-closing">
            <Icon name="whatsapp" size={18} /> {f.doors.assisted.cta}
          </a>
          <p class="mt-3 text-sm text-muted-ink">{f.doors.assisted.note}</p>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
