---
/**
 * The Free page's front door (/free/): both languages on one page, readable as it is, with
 * no script and no redirect, like the root page. The two buttons lead to /free/en/ and
 * /free/ar/. The language pages carry the full page; this one is what an agent or a
 * visitor with no language yet reads.
 */
import "@/styles/global.css";
import Logo from "@/components/ui/Logo.astro";
import Icon from "@/components/ui/Icon.astro";
import { t, dirOf } from "@/i18n";
import { LANGS, absoluteUrl, pageHref, signupHref } from "@/lib/site";

const title = "Madar Free: a café till, free for good | مدار المجاني";
const description = "Madar Free: a real point of sale and the reports behind it, one till in one branch, free for good. مدار المجاني: كاشير حقيقي وتقاريره، على كاشير واحد في فرع واحد، ببلاش.";
const ogImage = absoluteUrl("/og/en-free.jpg");
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteUrl("/free/")} />
    <link rel="alternate" hreflang="en" href={absoluteUrl(pageHref("en", "free"))} />
    <link rel="alternate" hreflang="ar" href={absoluteUrl(pageHref("ar", "free"))} />
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(pageHref("en", "free"))} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Madar POS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteUrl("/free/")} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#14181E" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="bg-paper text-ink">
    <main id="main">
      <section class="on-ink bg-ink text-paper">
        <div class="container-site pb-14 pt-12 md:pb-20 md:pt-16">
          <div aria-hidden="true" class="text-[1.6rem]"><Logo lang="en" tone="ink" /></div>
          <h1 class="text-h2 mt-10 max-w-4xl">Madar Free · <span lang="ar" dir="rtl">مدار المجاني</span> — a café till, free for good</h1>
          <nav aria-label="Language · اللغة" class="mt-8 flex flex-wrap gap-3">
            <a class="btn btn-paper btn-lg" href={pageHref("en", "free")} hreflang="en" lang="en">English</a>
            <a class="btn btn-ghost-ink btn-lg" href={pageHref("ar", "free")} hreflang="ar" lang="ar">العربية</a>
          </nav>
        </div>
      </section>
      <div class="container-site grid gap-16 py-16 md:grid-cols-2 md:py-24">
        {LANGS.map((lang) => {
          const c = t(lang);
          const f = c.freePage;
          const ar = lang === "ar";
          return (
            <section lang={lang} dir={dirOf(lang)} aria-labelledby={`free-${lang}`}>
              <h2 id={`free-${lang}`} class:list={["text-h3", ar && "!leading-[1.35] !tracking-normal"]}>{f.title}</h2>
              <p class:list={["text-lead mt-5 text-muted", ar && "!leading-[1.8]"]}>{f.sub}</p>
              <h3 class="mt-10 text-lg font-semibold">{f.included.title}</h3>
              <ul class="mt-4 grid gap-2.5">{f.included.items.map((i) => <li class="bullet">{i.t}</li>)}</ul>
              <h3 class="mt-10 text-lg font-semibold">{f.included.limitsTitle}</h3>
              <p class="mt-3">{f.included.limits}</p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a class="btn btn-ink btn-lg" href={pageHref(lang, "free")}>{c.nav.free} <Icon name="arrow" size={18} /></a>
                <a class="btn btn-outline btn-lg" href={signupHref(lang)}>{f.cta}</a>
              </div>
            </section>
          );
        })}
      </div>
    </main>
  </body>
</html>
