---
/**
 * The root page (/): a language picker. The browser goes straight on to /ar/ when its
 * first language is Arabic and to /en/ otherwise (src/scripts/classic/root.js), before
 * anything paints. Without JavaScript it shows the two languages as links (and a
 * noscript refresh to English). The build also writes it as get.html, which the get
 * vhost serves for / (deploy/nginx/get.madar-pos.cloud).
 * No CSS bundle and no view transition on this page: it is a hop, not a page.
 */
import symbol from "@/assets/brand/symbol-reversed.svg?raw";
import wordmark from "@/assets/brand/wordmark-reversed.svg?raw";
import rootUrl from "@/scripts/classic/root.js?url&no-inline";
import { absoluteUrl } from "@/lib/site";
import { organization, website } from "@/lib/schema";

const svg = (s: string) => s.replace(/<svg([^>]*?)\swidth="[^"]*"\sheight="[^"]*"/, "<svg$1").replace("<svg", '<svg aria-hidden="true" focusable="false"');
const title = "Madar POS · مدار: café point of sale for Egypt";
const description = "Madar POS, the café point of sale for Egypt that knows what every cup costs. مدار، سيستم كاشير للكافيهات بيحسب تكلفة كل كوباية.";
const ogImage = absoluteUrl("/og/en-home.jpg");
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <script is:inline src={rootUrl}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteUrl("/")} />
    <link rel="alternate" hreflang="en" href={absoluteUrl("/en/")} />
    <link rel="alternate" hreflang="ar" href={absoluteUrl("/ar/")} />
    <link rel="alternate" hreflang="x-default" href={absoluteUrl("/en/")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Madar POS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absoluteUrl("/")} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {[organization(), website()].map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <meta name="theme-color" content="#14181E" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <noscript><meta http-equiv="refresh" content="0; url=/en/" /></noscript>
    <style is:inline>
      html { background: #14181E; color: #EFF3F4; font: 500 16px/1.4 system-ui, sans-serif; }
      html.go body { visibility: hidden; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; }
      main { display: flex; flex-direction: column; align-items: center; gap: 32px; padding: 32px; }
      .logo { display: flex; align-items: center; gap: 14px; height: 40px; }
      .logo span { display: block; height: 100%; }
      .logo .w { height: 30px; }
      .logo svg { height: 100%; width: auto; display: block; }
      nav { display: flex; gap: 12px; }
      a { display: inline-block; padding: 12px 22px; border-radius: 999px; border: 1px solid #2B323A; color: inherit; text-decoration: none; }
      a:first-child { background: #EFF3F4; color: #14181E; border-color: #EFF3F4; }
    </style>
  </head>
  <body>
    <main>
      <div class="logo" role="img" aria-label="Madar POS"><span set:html={svg(symbol)} /><span class="w" set:html={svg(wordmark)} /></div>
      <nav>
        <a href="/en/" hreflang="en" lang="en">English</a>
        <a href="/ar/" hreflang="ar" lang="ar">العربية</a>
      </nav>
    </main>
  </body>
</html>
