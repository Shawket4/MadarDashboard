---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import Orbit from "@/components/ui/Orbit.astro";
import { BorderBeam } from "@/components/kit/BorderBeam";
import { t } from "@/i18n";
import { type Lang, LANGS, whatsappHref, absoluteUrl, pageHref } from "@/lib/site";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const c = t(lang);
const p = c.pricing;
const terms = ["monthly", "three", "six", "year"] as const;
const months = { monthly: 1, three: 3, six: 6, year: 12 } as const;
const fmt = (n: number) => new Intl.NumberFormat("en-US").format(n);

const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Madar",
  applicationCategory: "BusinessApplication",
  operatingSystem: "iPadOS, Android, Web",
  url: absoluteUrl(pageHref(lang, "pricing")),
  offers: p.plans.map((plan) => ({
    "@type": "Offer",
    name: plan.name,
    price: plan.prices.monthly,
    priceCurrency: "EGP",
    description: `${plan.name}: ${p.termTotal.monthly}, per branch`,
  })),
}];
---
<BaseLayout lang={lang} page="pricing" headerTone="paper" jsonLd={jsonLd}>
  <section class="relative isolate overflow-hidden bg-paper">
    <Orbit tone="paper" class="absolute -start-[36rem] -top-[30rem] -z-10 h-[76rem] w-[76rem] opacity-60" />
    <div class="container-site pb-10 pt-36 text-center md:pt-44">
      <p class="kicker text-teal" data-reveal>{p.kicker}</p>
      <h1 class="text-display mx-auto mt-5 max-w-4xl" data-split>{p.title}</h1>
      <p class="text-lead mx-auto mt-6 max-w-2xl text-muted" data-reveal>{p.sub}</p>

      <fieldset class="mx-auto mt-10 inline-flex rounded-full border border-rule bg-white p-1" data-terms>
        <legend class="sr-only">{p.termLabel}</legend>
        {terms.map((term, i) => (
          <label class="term-option relative cursor-pointer">
            <input type="radio" name="term" value={term} class="peer sr-only" checked={i === 0} />
            <span class="block rounded-full px-4 py-2 text-sm font-medium text-muted transition-colors peer-checked:bg-ink peer-checked:text-paper peer-focus-visible:outline-2 peer-focus-visible:outline-teal-light sm:px-5">{p.terms[term]}</span>
          </label>
        ))}
      </fieldset>
    </div>
  </section>

  <section class="bg-paper" aria-label={p.title}>
    <div class="container-site grid gap-6 pb-16 md:grid-cols-2 md:pb-24" data-plans>
      {p.plans.map((plan) => (
        <article class:list={["relative flex flex-col overflow-hidden rounded-[1.6rem] p-7 md:p-9", plan.featured ? "on-ink bg-ink text-paper" : "card"]} data-reveal>
          {plan.featured && <BorderBeam client:visible size={140} duration={9} colorFrom="#2E94A6" colorTo="#0D6273" borderWidth={1.5} />}
          <div class="flex items-start justify-between gap-3">
            <h2 class="text-2xl font-semibold">{plan.name}</h2>
            <span class:list={["chip mt-0.5 shrink-0 whitespace-nowrap", plan.featured ? "bg-teal-light text-ink" : "border border-rule text-muted"]}>{plan.tag}</span>
          </div>
          <p class:list={["mt-2", plan.featured ? "text-muted-ink" : "text-muted"]}>{plan.blurb}</p>

          <div class="mt-8" data-price-block>
            {terms.map((term, i) => {
              const total = plan.prices[term];
              const save = plan.prices.monthly * months[term] - total;
              return (
                <div class="price-term" data-term={term} hidden={i !== 0}>
                  <p class="flex items-baseline gap-2">
                    <span class="ltr font-mono text-5xl font-medium tracking-tight md:text-6xl">{fmt(total)}</span>
                    <span class:list={["text-sm", plan.featured ? "text-muted-ink" : "text-muted"]}>{p.currency} · {p.termTotal[term]}</span>
                  </p>
                  <p class:list={["mt-2 h-5 text-sm", plan.featured ? "text-teal-light" : "text-teal"]}>
                    {save > 0 && <span>{p.save} <span class="ltr">{fmt(save)}</span> {p.currency} · <span class="ltr">{fmt(Math.round(total / months[term]))}</span> {p.currency} {p.perMonthEquiv}</span>}
                  </p>
                </div>
              );
            })}
          </div>

          <ul class="mt-8 space-y-3">
            {plan.features.map((feat) => (
              <li class="flex gap-3">
                <span class:list={["mt-1", plan.featured ? "text-teal-light" : "text-teal"]}><Icon name="check" size={18} /></span>
                <span>{feat}</span>
              </li>
            ))}
          </ul>
          <div class="mt-auto pt-10">
            <a class:list={["btn btn-lg w-full", plan.featured ? "btn-accent" : "btn-primary"]} href={whatsappHref(lang)} target="_blank" rel="noopener" data-umami-event="whatsapp" data-umami-event-where={`pricing-${plan.key}`}>
              <Icon name="whatsapp" /> {c.contact.whatsapp}
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-paper">
    <div class="container-site grid gap-8 border-t border-ink/10 py-14 md:grid-cols-3" data-reveal-group>
      {p.notes.map((n) => (
        <div data-reveal>
          <h3 class="text-lg font-semibold">{n.title}</h3>
          <p class="mt-2 text-muted">{n.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-surface" aria-labelledby="free-title">
    <div class="container-site py-16 md:py-24">
      <div class="relative grid grid-cols-1 gap-10 overflow-hidden rounded-[2rem] border border-teal/20 bg-white p-6 sm:p-8 md:grid-cols-2 md:p-12" data-reveal>
        <BorderBeam client:visible size={180} duration={12} colorFrom="#2E94A6" colorTo="#0D6273" borderWidth={1.5} />
        <div class="min-w-0">
          <p class="kicker text-teal">{p.free.kicker}</p>
          <h2 id="free-title" class="text-h3 mt-4">{p.free.title}</h2>
          <p class="mt-4 text-muted">{p.free.body}</p>
          <a class="btn btn-primary btn-lg mt-8" href={whatsappHref(lang)} target="_blank" rel="noopener" data-umami-event="free-month" data-umami-event-where="pricing">
            <Icon name="whatsapp" /> {p.free.cta}
          </a>
          <p class="mt-4 font-mono text-sm text-muted">{p.free.note}</p>
        </div>
        <div class="min-w-0">
          <h3 class="text-lg font-semibold">{p.free.needTitle}</h3>
          <ul class="mt-5 space-y-3">
            {p.free.need.map((n) => (
              <li class="flex gap-3 rounded-2xl border border-rule bg-surface px-4 py-3">
                <span class="mt-0.5 text-teal"><Icon name="check" size={18} /></span><span>{n}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import gsap from "gsap";
  import { Flip } from "gsap/Flip";
  gsap.registerPlugin(Flip);
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const set = document.querySelector<HTMLFieldSetElement>("[data-terms]");
  set?.addEventListener("change", (e) => {
    const term = (e.target as HTMLInputElement).value;
    const blocks = Array.from(document.querySelectorAll<HTMLElement>("[data-price-block]"));
    const state = reduce ? null : Flip.getState(blocks.flatMap((b) => Array.from(b.children)));
    for (const b of blocks) {
      for (const el of Array.from(b.querySelectorAll<HTMLElement>(".price-term"))) el.hidden = el.dataset.term !== term;
    }
    if (state) {
      Flip.from(state, { duration: 0.45, ease: "expo.out", absolute: true, onEnter: (els) => gsap.fromTo(els, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.45, ease: "expo.out" }), onLeave: (els) => gsap.to(els, { opacity: 0, y: -10, duration: 0.25 }) });
    }
  });
</script>
