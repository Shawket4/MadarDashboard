---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Hero from "@/components/kit/Hero.astro";
import CrewMoment from "@/components/kit/CrewMoment.astro";
import FaqList from "@/components/kit/FaqList.astro";
import Icon from "@/components/ui/Icon.astro";
import { t } from "@/i18n";
import { type Lang, LANGS, whatsappHref } from "@/lib/site";
import { breadcrumbs, faqPage } from "@/lib/schema";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const c = t(lang);
const f = c.faq;
const jsonLd = [faqPage(lang, f.items), breadcrumbs(lang, "faq")];
---
<BaseLayout lang={lang} page="faq" headerTone="paper" jsonLd={jsonLd}>
  <Hero split={4} sticky kicker={f.kicker} title={f.title} lead={f.sub}>
    <Fragment slot="actions">
      <a class="btn btn-ink btn-lg" href={whatsappHref(lang)} target="_blank" rel="noopener" data-umami-event="whatsapp" data-umami-event-where="faq">
        {c.contact.whatsapp} <Icon name="arrow" size={18} />
      </a>
      <!-- نقطة at the counter, waving: ask him anything (wide screens, beside the questions). -->
      <CrewMoment pose="wave" class="faq-nuqta" host="faq-crew" />
    </Fragment>
    <FaqList items={f.items} />
  </Hero>
</BaseLayout>
