---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { t } from "@/i18n";
import { type Lang, LANGS, whatsappHref } from "@/lib/site";
import { breadcrumbs } from "@/lib/schema";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const c = t(lang);
const f = c.faq;
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: f.items.map((i) => ({ "@type": "Question", name: i.q, acceptedAnswer: { "@type": "Answer", text: i.a } })),
}, breadcrumbs(lang, "faq")];
---
<BaseLayout lang={lang} page="faq" headerTone="paper" jsonLd={jsonLd}>
  <section class="bg-paper">
    <div class="container-site grid gap-12 pb-20 pt-36 md:pt-44 lg:grid-cols-12 lg:gap-16 lg:pb-28">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <p class="kicker text-teal" data-reveal>{f.kicker}</p>
          <h1 class="text-display mt-5" data-split>{f.title}</h1>
          <p class="text-lead mt-6 text-muted" data-reveal>{f.sub}</p>
          <a class="btn btn-ink btn-lg mt-8" href={whatsappHref(lang)} target="_blank" rel="noopener" data-umami-event="whatsapp" data-umami-event-where="faq" data-reveal>
            {c.contact.whatsapp} <Icon name="arrow" size={18} />
          </a>
        </div>
      </div>
      <div class="lg:col-span-8">
        <div class="divide-y divide-ink/10 border-y border-ink/10" data-reveal-group>
          {f.items.map((item, i) => (
            <details class="faq-item group" open={i === 0} data-reveal>
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-lg font-semibold leading-snug marker:hidden [&::-webkit-details-marker]:hidden">
                <span>{item.q}</span>
                <span class="mt-1 grid h-7 w-7 shrink-0 place-items-center rounded-full border border-rule text-teal transition-transform duration-300 group-open:rotate-45">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                </span>
              </summary>
              <p class="max-w-2xl pb-7 text-muted">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
