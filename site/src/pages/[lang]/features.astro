---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Section from "@/components/kit/Section.astro";
import FeatureArea from "@/components/features/FeatureArea.astro";
import Roadmap from "@/components/features/Roadmap.astro";
import BasiraDemo from "@/components/home/BasiraDemo.astro";
import LedgerBeams from "@/components/kit/LedgerBeams.astro";
import CtaBand from "@/components/kit/CtaBand.astro";
import Hero from "@/components/kit/Hero.astro";
import FeatureGrid from "@/components/kit/FeatureGrid.astro";
import CrewMoment from "@/components/kit/CrewMoment.astro";
import { t, featureGroups } from "@/i18n";
import { type Lang, LANGS, pageHref, signupHref } from "@/lib/site";
import { breadcrumbs } from "@/lib/schema";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const c = t(lang);
const a = c.areas;
const f = c.features;

const groups = featureGroups(lang);
---
<BaseLayout lang={lang} page="features" headerTone="paper" jsonLd={[breadcrumbs(lang, "features")]}>
  <Hero kicker={f.kicker} title={f.title} lead={f.intro} headClass="max-w-5xl" orbit="-end-[34rem] -top-[34rem] h-[76rem] w-[76rem] opacity-70" />

  <!-- What today's POS gets wrong -->
  <Section id="wrong" tone="ink" split={4} kicker={f.wrongKicker} title={f.wrongTitle}>
    <FeatureGrid items={f.wrong} numbered variant="card" tone="ink" size="xl" />
  </Section>

  <!-- One ledger -->
  <Section id="ledger" tone="surface" center kicker={f.ledger.kicker} title={f.ledger.title} lead={f.ledger.body}>
    <div data-reveal>
      <LedgerBeams labels={f.ledger.labels} />
    </div>
  </Section>

  <!-- Jump to -->
  <nav class="sticky top-16 z-20 border-y border-ink/10 bg-paper/90 backdrop-blur-md" aria-label={f.indexLabel} data-jump-nav>
    <div class="container-site flex gap-6 overflow-x-auto py-3 [scrollbar-width:none]">
      {groups.map((g) => (
        <div class="flex shrink-0 items-center gap-1.5">
          <span class="me-1 text-xs font-semibold text-muted">{g.label}</span>
          {g.items.map(([id, label]) => (
            <a class="chip hit press border border-rule bg-white text-ink hover:border-teal" href={`#${id}`}>{label}</a>
          ))}
        </div>
      ))}
    </div>
  </nav>

  <FeatureArea lang={lang} id="till" {...a.till} shots={[
    { id: "pos-close-till", frame: "ipad", alt: a.till.alts.closeTill },
    { id: "pos-charge", frame: "ipad", alt: a.till.alts.charge },
    { id: "pos-manager-pin", frame: "ipad", alt: a.till.alts.managerPin },
    { id: "pos-till-report", frame: "ipad", alt: a.till.alts.tillReport },
  ]} />
  <FeatureArea lang={lang} id="inventory" tone="surface" {...a.inventory} shots={[
    { id: "dash-ingredients", frame: "browser", alt: a.inventory.alts.ingredients },
    { id: "dash-reorder", frame: "browser", alt: a.inventory.alts.reorder },
    { id: "dash-purchasing", frame: "browser", alt: a.inventory.alts.purchasing },
  ]} />
  <FeatureArea lang={lang} id="counter" {...a.counter} shots={[
    { id: "pos-cart", frame: "ipad", alt: c.hero.altPos },
    { id: "pos-item", frame: "ipad", alt: a.counter.alts.item },
  ]} />
  <FeatureArea lang={lang} id="floor" tone="surface" {...a.floor} shots={[
    { id: "pos-table", frame: "ipad", alt: a.floor.alts.table },
    { id: "kds-board", frame: "ipad", alt: a.floor.alts.kds },
    { id: "dash-floor", frame: "browser", alt: a.floor.alts.dashFloor },
    { id: "order-table", frame: "iphone", alt: a.floor.alts.orderTable },
  ]} />
  <FeatureArea lang={lang} id="ordering" {...a.ordering} shots={[
    { id: "order-menu", frame: "iphone", alt: a.ordering.alts.menu },
    { id: "order-customize", frame: "iphone", alt: a.ordering.alts.customize },
    { id: "order-channel", frame: "iphone", alt: a.ordering.alts.channel },
    { id: "order-checkout", frame: "iphone", alt: a.ordering.alts.checkout },
    { id: "order-track", frame: "iphone", alt: a.ordering.alts.track },
  ]} />
  <FeatureArea lang={lang} id="loyalty" tone="surface" {...a.loyalty} shots={[
    { id: "wallet-pass", frame: "iphone", alt: a.loyalty.alts.pass },
    { id: "loyalty-join", frame: "iphone", alt: a.loyalty.alts.join },
    { id: "loyalty-card", frame: "iphone", alt: a.loyalty.alts.card },
  ]} />
  <FeatureArea lang={lang} id="menu" {...a.menu} shots={[
    { id: "dash-quadrant", frame: "browser", alt: a.menu.alts.quadrant },
    { id: "dash-repricing", frame: "browser", alt: a.menu.alts.repricing },
    { id: "dash-decisions", frame: "browser", alt: a.menu.alts.decisions },
  ]} />
  <FeatureArea lang={lang} id="basira" tone="surface" {...a.basira}>
    <BasiraDemo lang={lang} />
  </FeatureArea>
  <FeatureArea lang={lang} id="hq" {...a.hq} shots={[
    { id: "dash-overview", frame: "browser", alt: a.hq.alts.overview },
    { id: "dash-menu-pricing", frame: "browser", alt: a.hq.alts.menuPricing },
    { id: "dash-access", frame: "browser", alt: a.hq.alts.access },
    { id: "dash-export", frame: "browser", alt: a.hq.alts.export },
    { id: "dash-legal", frame: "browser", alt: a.hq.alts.legal },
  ]} />
  <FeatureArea lang={lang} id="dawam" tone="surface" {...a.dawam} />
  <FeatureArea lang={lang} id="setup" {...a.setup} shots={[
    { id: "dash-payments", frame: "browser", alt: a.setup.alts.payments },
  ]} />

  <!-- The other door, as on pricing: Madar Free, with the crew cheering on its edge. -->
  <Section pad="tight" label={c.pricing.freePlan.kicker}>
    <CtaBand
      class="mt-16"
      kicker={c.pricing.freePlan.kicker}
      title={c.pricing.freePlan.title}
      body={c.pricing.freePlan.body}
      price={{ amount: c.pricing.freePlan.price, per: c.pricing.freePlan.per }}
      cta={{ href: signupHref(lang), label: c.pricing.freePlan.cta, event: "free-signup", where: "features" }}
      more={{ href: pageHref(lang, "free"), label: c.pricing.freePlan.more, event: "free-page", where: "features" }}
    >
      <Fragment slot="crew"><CrewMoment pose="slice-joy" class="cta-band-shariha" /><CrewMoment pose="joy" class="cta-band-nuqta" /></Fragment>
    </CtaBand>
  </Section>

  <Roadmap lang={lang} />
</BaseLayout>
