---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import Orbit from "@/components/ui/Orbit.astro";
import Logo from "@/components/ui/Logo.astro";
import { t } from "@/i18n";
import { type Lang, LANGS, whatsappHref } from "@/lib/site";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const c = t(lang);
const ab = c.about;
const free = c.pricing.free;
---
<BaseLayout lang={lang} page="about" headerTone="ink">
  <section class="on-ink relative isolate overflow-hidden bg-ink text-paper">
    <Orbit tone="ink" class="absolute -end-[30rem] -top-[26rem] -z-10 h-[76rem] w-[76rem]" />
    <div class="container-site pb-20 pt-36 md:pb-28 md:pt-44">
      <p class="kicker text-teal-light" data-reveal>{ab.kicker}</p>
      <h1 class="text-display mt-5 max-w-5xl" data-split>{ab.title}</h1>
      <p class="text-lead mt-7 max-w-2xl text-muted-ink" data-reveal>{ab.lead}</p>
    </div>
  </section>

  <section class="bg-paper">
    <div class="container-site grid gap-x-10 gap-y-12 py-20 md:grid-cols-2 md:py-28" data-reveal-group>
      {ab.sections.map((s, i) => (
        <div class="border-t border-ink/15 pt-6" data-reveal>
          <span class="ltr font-mono text-sm text-teal">0{i + 1}</span>
          <h2 class="mt-3 text-2xl font-semibold leading-snug">{s.title}</h2>
          <p class="mt-3 text-lg text-muted">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-surface" aria-labelledby="need-title">
    <div class="container-site grid gap-12 py-20 md:py-28 lg:grid-cols-2">
      <div>
        <p class="kicker text-teal" data-reveal>{free.kicker}</p>
        <h2 class="text-h2 mt-4" data-split>{free.title}</h2>
        <p class="text-lead mt-5 text-muted" data-reveal>{free.body}</p>
        <a class="btn btn-primary btn-lg mt-8" href={whatsappHref(lang)} target="_blank" rel="noopener" data-umami-event="free-month" data-umami-event-where="about" data-reveal>
          <Icon name="whatsapp" /> {free.cta}
        </a>
      </div>
      <div>
        <h3 id="need-title" class="text-lg font-semibold" data-reveal>{free.needTitle}</h3>
        <ul class="mt-5 space-y-3" data-reveal-group>
          {free.need.map((n) => (
            <li class="card flex gap-3 px-5 py-4" data-reveal>
              <span class="mt-0.5 text-teal"><Icon name="check" size={18} /></span><span>{n}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-paper" aria-labelledby="partner-title">
    <div class="container-site py-20 text-center md:py-28">
      <span class="inline-flex text-[2.6rem]" data-reveal><Logo lang={lang} tone="paper" display /></span>
      <p class="kicker mt-8 text-teal" data-reveal>{ab.partnerKicker}</p>
      <h2 id="partner-title" class="text-h2 mx-auto mt-4 max-w-3xl" data-split>{ab.partnerTitle}</h2>
      <p class="text-lead mx-auto mt-5 max-w-2xl text-muted" data-reveal>{ab.partnerBody}</p>
    </div>
  </section>
</BaseLayout>
