---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Section from "@/components/kit/Section.astro";
import Hero from "@/components/kit/Hero.astro";
import FeatureGrid from "@/components/kit/FeatureGrid.astro";
import CheckList from "@/components/kit/CheckList.astro";
import Icon from "@/components/ui/Icon.astro";
import Logo from "@/components/ui/Logo.astro";
import { t } from "@/i18n";
import { type Lang, LANGS, whatsappHref } from "@/lib/site";
import { breadcrumbs } from "@/lib/schema";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const c = t(lang);
const ab = c.about;
const free = c.pricing.free;
const jsonLd = [breadcrumbs(lang, "about")];
---
<BaseLayout lang={lang} page="about" headerTone="ink" jsonLd={jsonLd}>
  <Hero tone="ink" kicker={ab.kicker} title={ab.title} lead={ab.lead} headClass="max-w-5xl" orbit="-end-[30rem] -top-[26rem] h-[76rem] w-[76rem]" />

  <Section label={ab.kicker}>
    <FeatureGrid items={ab.sections} numbered size="2xl" as="h2" />
  </Section>

  <Section id="need" tone="surface" split={6} kicker={free.kicker} title={free.title} lead={free.body}>
    <a slot="head" class="btn btn-ink btn-lg mt-8" href={whatsappHref(lang)} target="_blank" rel="noopener" data-umami-event="free-month" data-umami-event-where="about" data-reveal>
      {free.cta} <Icon name="arrow" size={18} />
    </a>
    <h3 class="text-lg font-semibold" data-reveal>{free.needTitle}</h3>
    <CheckList class="mt-5" items={free.need} ruled />
  </Section>

  <Section id="partner" center kicker={ab.partnerKicker} title={ab.partnerTitle} lead={ab.partnerBody}>
    <span slot="mark" class="mb-8 inline-flex text-[2.6rem]" data-reveal><Logo lang={lang} tone="paper" display /></span>
  </Section>
</BaseLayout>
