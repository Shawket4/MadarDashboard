---
/**
 * Contact: every way to reach Madar as plain links, readable without JavaScript and by
 * crawlers and agents. The contact sheet (the header's "Talk to us") stays as it is.
 */
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { t } from "@/i18n";
import {
  type Lang, LANGS, whatsappHref, PHONE_HREF, PHONE_DISPLAY, EMAIL, EMAIL_HREF, INSTAGRAM, FACEBOOK,
} from "@/lib/site";
import { breadcrumbs } from "@/lib/schema";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const c = t(lang);
const cp = c.contactPage;
const jsonLd = [breadcrumbs(lang, "contact")];
const rows = [
  { label: cp.whatsapp, value: PHONE_DISPLAY, href: whatsappHref(lang), icon: "whatsapp", event: "whatsapp", ltr: true, external: true },
  { label: cp.phone, value: PHONE_DISPLAY, href: PHONE_HREF, icon: "phone", event: "call", ltr: true, external: false },
  { label: cp.email, value: EMAIL, href: EMAIL_HREF, icon: "mail", event: "email", ltr: true, external: false },
  { label: cp.instagram, value: "@madar.cloud", href: INSTAGRAM, icon: "instagram", event: "instagram", ltr: true, external: true },
  { label: cp.facebook, value: "Madar - مدار", href: FACEBOOK, icon: "facebook", event: "facebook", ltr: false, external: true },
] as const;
---
<BaseLayout lang={lang} page="contact" headerTone="paper" jsonLd={jsonLd}>
  <section class="bg-paper">
    <div class="container-site grid gap-12 pb-20 pt-36 md:pt-44 lg:grid-cols-12 lg:gap-16 lg:pb-28">
      <div class="lg:col-span-5">
        <p class="kicker text-teal" data-reveal>{cp.kicker}</p>
        <h1 class="text-display mt-5" data-split>{c.contact.title}</h1>
        <p class="text-lead mt-6 text-muted" data-reveal>{c.contact.subtitle}</p>
      </div>
      <div class="lg:col-span-7">
        <h2 class="text-lg font-semibold" data-reveal>{cp.channels}</h2>
        <ul class="mt-5 divide-y divide-ink/10 border-y border-ink/10" data-reveal-group>
          {rows.map((r) => (
            <li class="flex items-center gap-4 py-5" data-reveal>
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-teal/10 text-teal"><Icon name={r.icon} /></span>
              <span class="min-w-0">
                <span class="block text-sm text-muted">{r.label}<span class="sr-only">:</span></span>
                <a
                  class:list={["break-all font-medium underline decoration-ink/25 underline-offset-4 hover:decoration-teal", r.ltr && "ltr inline-block"]}
                  href={r.href}
                  target={r.external ? "_blank" : undefined}
                  rel={r.external ? "noopener" : undefined}
                  data-umami-event={r.event}
                  data-umami-event-where="contact-page"
                >{r.value}</a>
              </span>
            </li>
          ))}
          <li class="flex items-center gap-4 py-5" data-reveal>
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-teal/10 text-teal"><Icon name="globe" /></span>
            <span>
              <span class="block text-sm text-muted">{cp.city}<span class="sr-only">:</span></span>
              <span class="font-medium">{cp.cityValue}</span>
            </span>
          </li>
        </ul>
        <a class="btn btn-ink btn-lg mt-8" href={whatsappHref(lang)} target="_blank" rel="noopener" data-umami-event="whatsapp" data-umami-event-where="contact-page-cta" data-reveal>
          {c.contact.whatsapp} <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
