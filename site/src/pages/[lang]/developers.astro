---
/**
 * Developers: the public API and the MCP server on api.madar-pos.cloud, in English only
 * (Arabic pages link here). Endpoints are from the backend's openapi.json (paths under
 * /public/); the MCP server is MadarRust src/mcp.rs. Change them together.
 */
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { type Lang, EMAIL, EMAIL_HREF, PHONE_DISPLAY, PHONE_E164, absoluteUrl } from "@/lib/site";
import { breadcrumbs } from "@/lib/schema";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }];
}
const { lang } = Astro.params as { lang: Lang };
const jsonLd = [breadcrumbs(lang, "developers")];

const API = "https://api.madar-pos.cloud";
const SPEC = `${API}/openapi.json`;
const MCP = `${API}/mcp`;
const MANIFEST = absoluteUrl("/.well-known/mcp.json");
const CARD = `${API}/.well-known/mcp/server-card.json`;
const WHATSAPP = `https://wa.me/${PHONE_E164.replace("+", "")}`;

const endpoints = [
  ["/public/orgs/brand?slug={shop}", "The shop's id, name, logo and colours. Pass org_id={uuid} instead of slug when you have the id."],
  ["/public/orgs/links?slug={shop}", "The shop's links page in one call: brand, taglines, its buttons (order online, menu, book a table, rewards, its own links) with their addresses, social links, and branches with address, phone and directions."],
  ["/public/branches?org_id={uuid}&browse=true", "The shop's active branches: id, name, and which ordering channels are on and open now. Without browse=true, only the branches that take online orders."],
  ["/public/branches/{id}/menu?channel=dine_in&preview=true", "A branch's menu: categories, items with sizes, add-ons and deals. dine_in with preview=true is the read-only menu at branch prices. An ordering channel (pickup, outside, in_mall, umbrella) gives that channel's prices, and only while it is open unless preview=true."],
  ["/public/branches/{id}/booking-slots?date=YYYY-MM-DD&party_size={n}", "The branch's bookable start times that day for that party size, each marked available or not, with the branch's time zone."],
  ["/public/delivery-orders/{id}/track", "An online order's status, the time of each step, and its totals, by the order id in its tracking link."],
];

const tools = [
  ["get_shop", "shop: string", "The shop's name, tagline, links (order online, menu, book a table, rewards), social links, and branches (id, name, address, phone, directions)."],
  ["get_menu", "shop: string, branch_id?: string (uuid)", "The menu: categories and items with prices in EGP, sizes where an item has them. Without branch_id, the shop's first branch."],
  ["get_booking_slots", "branch_id: string (uuid), date: string (YYYY-MM-DD), party_size: integer", "The branch's bookable times that day, and which are available."],
  ["track_order", "order_id: string (uuid)", "An online order's status and timeline, without customer details."],
  ["about_madar", "none", "What Madar POS is, its plans and monthly prices per branch, and how to reach sales."],
];

const ex = {
  links: `curl -s '${API}/public/orgs/links?slug=drops'`,
  linksOut: `{
  "brand": { "org_id": "2f6c0d4e-…", "name": "Drops", "slug": "drops", "logo_url": "https://…", … },
  "tagline_en": "…",
  "items": [
    { "kind": "order", "href": "https://drops.madar-pos.cloud/order/", "channels": ["pickup"], "branch_names": ["…"] },
    { "kind": "book", "href": "https://drops.madar-pos.cloud/book/", "channels": [], "branch_names": ["…"] }
  ],
  "socials": [{ "key": "instagram", "label": "Instagram", "url": "https://www.instagram.com/…" }],
  "branches": [
    { "id": "8d1e5a2c-…", "name": "…", "address": "…", "phone": "…", "directions_url": "https://…" }
  ]
}`,
  menu: `curl -s "${API}/public/branches/$BRANCH_ID/menu?channel=dine_in&preview=true"`,
  menuOut: `{
  "categories": [{ "id": "…", "name": "Hot drinks", "name_translations": { "ar": "مشروبات سخنة" } }],
  "items": [
    {
      "id": "…", "category_id": "…", "kind": "item", "name": "Cappuccino", "price": 6500,
      "sizes": [{ "label": "Small", "price": 6500 }, { "label": "Large", "price": 8000 }],
      …
    }
  ],
  "addons": [ … ],
  "deals": [],
  "discount": null
}`,
  slots: `curl -s "${API}/public/branches/$BRANCH_ID/booking-slots?date=2026-10-10&party_size=4"`,
  slotsOut: `{
  "date": "2026-10-10",
  "timezone": "Africa/Cairo",
  "slots": [
    { "starts_at": "2026-10-10T15:00:00Z", "available": true },
    { "starts_at": "2026-10-10T15:30:00Z", "available": false }
  ]
}`,
  notFound: `curl -si '${API}/public/orgs/brand?slug=no-such-shop'
HTTP/2 404
content-type: application/json

{"error":"Not found"}`,
  limited: `HTTP/2 429
retry-after: 12
content-type: application/json

{"error":"Too many requests just now. This will clear in a moment.","code":"RATE_LIMITED","retry_after_seconds":12}`,
  init: `curl -s ${MCP} \\
  -H 'Content-Type: application/json' \\
  -H 'Accept: application/json, text/event-stream' \\
  -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"my-agent","version":"1.0"}}}'`,
  initOut: `{"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"2025-06-18","capabilities":{"tools":{"listChanged":false}},"serverInfo":{"name":"madar-pos","title":"Madar POS","version":"…"},"instructions":"…"}}`,
  list: `curl -s ${MCP} \\
  -H 'Content-Type: application/json' \\
  -H 'Accept: application/json, text/event-stream' \\
  -d '{"jsonrpc":"2.0","id":2,"method":"tools/list"}'`,
  call: `curl -s ${MCP} \\
  -H 'Content-Type: application/json' \\
  -H 'Accept: application/json, text/event-stream' \\
  -d '{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"get_menu","arguments":{"shop":"drops"}}}'`,
};
---
<BaseLayout lang={lang} page="developers" headerTone="paper" closing={false} jsonLd={jsonLd}>
  <article class="container-site pb-20 pt-36 md:pt-44 lg:pb-28">
    <div class="dev max-w-4xl">
      <p class="kicker text-teal">Developers</p>
      <h1 class="text-h2 mt-5">Madar POS API and MCP server</h1>
      <p class="text-lead mt-6 text-muted">
        Read a café's own public data: its brand and links page, branches, menu with prices in EGP,
        table booking times and the status of an online order. No account and no key.
      </p>

      <dl class="facts">
        <dt>Base URL</dt><dd><code>{API}</code></dd>
        <dt>Authentication</dt><dd>None for paths under <code>/public/</code></dd>
        <dt>Format</dt><dd>JSON over HTTPS</dd>
        <dt>OpenAPI</dt><dd><a href={SPEC}><code>{SPEC}</code></a></dd>
        <dt>MCP server</dt><dd><code>{MCP}</code> (Streamable HTTP)</dd>
      </dl>

      <h2>What it's for</h2>
      <p>
        Every café or restaurant on Madar POS has public pages: a links page, a menu, online ordering,
        table booking and order tracking. The API behind them is open to read, so an app or an AI agent
        can answer questions like "what does a large latte cost at Drops?" or "is there a table for four
        on Friday at 7?".
      </p>
      <p>
        Every call names one shop: by its address name (<code>drops</code> for
        <code>drops.madar-pos.cloud</code>) or by its id. There is no list of all shops, on purpose:
        you start from a shop you already know.
      </p>
      <p>
        Prices are whole numbers of piastres, in Egyptian pounds: <code>6500</code> is 65.00 EGP.
        Times are ISO 8601 in UTC; booking answers carry the branch's time zone.
      </p>

      <h2>Endpoints</h2>
      <p>All are <code>GET</code>, under <code>{API}</code>.</p>
      <div class="table-wrap" tabindex="0">
        <table>
          <thead><tr><th scope="col">Method</th><th scope="col">Path</th><th scope="col">Returns</th></tr></thead>
          <tbody>
            {endpoints.map(([path, what]) => (
              <tr><td><code>GET</code></td><td><code>{path}</code></td><td>{what}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        A typical path: the links page by the shop's address name gives its branches and their ids;
        a branch id gives the menu and the booking times.
      </p>

      <h2>Examples</h2>
      <h3>A shop's links page and branches</h3>
      <pre tabindex="0"><code class="language-bash">{ex.links}</code></pre>
      <pre tabindex="0"><code class="language-json">{ex.linksOut}</code></pre>
      <h3>A branch's menu</h3>
      <pre tabindex="0"><code class="language-bash">{ex.menu}</code></pre>
      <pre tabindex="0"><code class="language-json">{ex.menuOut}</code></pre>
      <h3>Free tables on a date</h3>
      <pre tabindex="0"><code class="language-bash">{ex.slots}</code></pre>
      <pre tabindex="0"><code class="language-json">{ex.slotsOut}</code></pre>

      <h2>Ordering and booking</h2>
      <p>
        Placing an order (<code>POST /public/delivery-orders</code>) or a booking
        (<code>POST /public/bookings</code>) needs the customer's WhatsApp one-time code
        (<code>POST /public/otp/request</code>, then <code>POST /public/otp/verify</code>). So an agent
        should not try to finish it for them: send the person the shop's order or booking link (the
        <code>order</code> and <code>book</code> items of <code>/public/orgs/links</code>, such as
        <code>https://drops.madar-pos.cloud/order/</code>) and they finish there.
      </p>

      <h2>Limits and errors</h2>
      <p>
        Requests are limited per client IP. Over the limit, the answer is <code>429</code> with a
        <code>Retry-After</code> header and a JSON body that says how long to wait:
      </p>
      <pre tabindex="0"><code class="language-http">{ex.limited}</code></pre>
      <p>
        Every error is JSON with an <code>error</code> message. An address name that isn't a shop (or
        a shop that is switched off) answers <code>404</code>:
      </p>
      <pre tabindex="0"><code class="language-bash">{ex.notFound}</code></pre>
      <p>Cache what you read, and don't crawl.</p>

      <h2>OpenAPI</h2>
      <p>
        The public part of the API, as OpenAPI 3.1: <a href={SPEC}><code>{SPEC}</code></a>
        (<code>get.madar-pos.cloud/openapi.json</code> redirects there).
      </p>

      <h2>MCP server</h2>
      <p>
        The same data as tools for AI assistants, over the Model Context Protocol. Read-only, no
        authentication, and the same per-IP rate limits as the API.
      </p>
      <dl class="facts">
        <dt>Endpoint</dt><dd><code>{MCP}</code></dd>
        <dt>Transport</dt><dd>Streamable HTTP, stateless: each <code>POST</code> carries one JSON-RPC message and is answered with <code>application/json</code>. No session id and no SSE stream; <code>GET /mcp</code> answers <code>405</code>.</dd>
        <dt>Protocol versions</dt><dd><code>2025-06-18</code> (default), <code>2025-03-26</code>, <code>2024-11-05</code></dd>
        <dt>Authentication</dt><dd>None</dd>
        <dt>Manifest</dt><dd><a href={MANIFEST}><code>{MANIFEST}</code></a></dd>
        <dt>Server card</dt><dd><a href={CARD}><code>{CARD}</code></a></dd>
      </dl>

      <h3>Tools</h3>
      <div class="table-wrap" tabindex="0">
        <table>
          <thead><tr><th scope="col">Tool</th><th scope="col">Input</th><th scope="col">Returns</th></tr></thead>
          <tbody>
            {tools.map(([name, input, what]) => (
              <tr><td><code>{name}</code></td><td><code>{input}</code></td><td>{what}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3>Try it</h3>
      <p>Start a session (optional, since the server keeps no state):</p>
      <pre tabindex="0"><code class="language-bash">{ex.init}</code></pre>
      <pre tabindex="0"><code class="language-json">{ex.initOut}</code></pre>
      <p>List the tools:</p>
      <pre tabindex="0"><code class="language-bash">{ex.list}</code></pre>
      <p>Call one:</p>
      <pre tabindex="0"><code class="language-bash">{ex.call}</code></pre>

      <h2>Contact</h2>
      <p>
        Questions about the API or the MCP server, or something you need from it: email
        <a href={EMAIL_HREF}>{EMAIL}</a> or WhatsApp <a href={WHATSAPP} target="_blank" rel="noopener">{PHONE_DISPLAY}</a>.
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  /* Long URLs and paths break rather than widen the page; tables scroll in their box on phones. */
  .dev :not(pre) > code, .dev a { overflow-wrap: anywhere; }
  .dev h2 { margin-top: 3.5rem; font-size: 1.6rem; font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; }
  .dev h3 { margin-top: 2rem; font-size: 1.15rem; font-weight: 600; }
  .dev p { margin-top: 1rem; }
  .dev p, .dev dd, .dev td { line-height: 1.65; }
  .dev a { text-decoration: underline; text-decoration-color: color-mix(in oklab, currentColor 35%, transparent); text-underline-offset: .25em; }
  .dev a:hover { text-decoration-color: currentColor; }
  .dev code { font-family: var(--font-mono); font-size: .88em; }
  .dev :not(pre) > code { background: var(--color-white); border: 1px solid var(--color-rule); border-radius: .3rem; padding: .05em .3em; }
  .dev pre { margin-top: 1rem; overflow-x: auto; border-radius: .75rem; background: var(--color-ink); color: var(--color-paper); padding: 1rem 1.15rem; font-size: .85rem; line-height: 1.55; }
  .dev .facts { display: grid; grid-template-columns: minmax(8rem, max-content) 1fr; gap: .6rem 1.5rem; margin-top: 2rem; }
  .dev .facts dt { font-weight: 600; }
  @media (max-width: 479px) { .dev .facts { grid-template-columns: 1fr; gap: .15rem; } .dev .facts dd { margin-bottom: .6rem; } }
  .dev .table-wrap { margin-top: 1rem; overflow-x: auto; }
  .dev :is(pre, .table-wrap):focus-visible { outline: 2px solid var(--color-teal); outline-offset: 3px; }
  .dev table { width: 100%; min-width: 36rem; border-collapse: collapse; font-size: .95rem; }
  .dev th, .dev td { text-align: start; vertical-align: top; padding: .7rem .75rem; border-bottom: 1px solid var(--color-rule); }
  .dev th { font-weight: 600; border-bottom-color: var(--color-ink); }
  .dev td:first-child, .dev th:first-child { padding-inline-start: 0; white-space: nowrap; }
  .dev td:nth-child(2) { min-width: 13rem; }
</style>
