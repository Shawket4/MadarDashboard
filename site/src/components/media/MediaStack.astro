---
/**
 * Screens for one area, arranged so the scroll story can bring the one that matches
 * the current paragraph to the front.
 *  - deck: same-size cards stacked with an offset (browser or iPad)
 *  - fan:  phones side by side; the active one steps forward
 * An optional floating phone sits over a deck (e.g. the guest's QR order on the floor).
 * Without JavaScript (or with reduced motion) it is a still composition.
 */
import Shot from "./Shot.astro";
import type { Lang } from "@/lib/site";

type Item = { id: string; frame: "browser" | "ipad" | "iphone"; alt: string };
interface Props {
  lang: Lang;
  items: Item[];
  layout?: "deck" | "fan";
  float?: Item;
  class?: string;
  sizes?: string;
}
const { lang, items, layout = "deck", float, class: cls = "", sizes } = Astro.props;
const frame = items[0]?.frame ?? "browser";
const aspect = frame === "browser" ? "aspect-[16/11]" : frame === "ipad" ? "aspect-[1.45/1]" : "aspect-[0.46/1]";
const deckSizes = sizes ?? (frame === "browser" ? "(min-width: 1024px) 46vw, 92vw" : "(min-width: 1024px) 42vw, 88vw");
---
{layout === "deck" ? (
  <div class:list={["media-deck relative pe-[9%] pt-[9%]", cls]} data-media="deck">
    <div class:list={["relative", aspect]}>
      {items.map((it, i) => (
        <div
          class="deck-card absolute inset-0 will-change-transform"
          data-card={i}
          style={`z-index:${items.length - i}; transform: translate(calc(${i} * 4.5% * var(--dir, 1)), ${-i * 4.5}%) scale(${1 - i * 0.065}); opacity:${i === 0 ? 1 : Math.max(0.35, 1 - i * 0.3)}; transform-origin: 50% 0;`}
        >
          <Shot id={it.id} lang={lang} alt={it.alt} frame={it.frame} sizes={deckSizes} class="h-full" fill />
        </div>
      ))}
    </div>
    {float && (
      <div class="float-card absolute -bottom-10 start-[-4%] z-30 w-[30%] max-w-[13rem]" data-float>
        <Shot id={float.id} lang={lang} alt={float.alt} frame={float.frame} sizes="(min-width: 1024px) 13rem, 30vw" />
      </div>
    )}
  </div>
) : (
  <div class:list={["media-fan relative mx-auto flex max-w-[40rem] items-end justify-center", cls]} data-media="fan">
    {items.map((it, i) => (
      <div
        class="fan-card relative w-[36%] shrink-0 will-change-transform"
        data-card={i}
        style={`margin-inline:-2.5%; z-index:${i === 0 ? 3 : 2 - Math.min(i, 1)}; transform: translateY(${i === 0 ? -4 : 2}%) scale(${i === 0 ? 1.04 : 0.94}); opacity:${i === 0 ? 1 : 0.72};`}
      >
        <Shot id={it.id} lang={lang} alt={it.alt} frame={it.frame} sizes="(min-width: 1024px) 15rem, 36vw" />
      </div>
    ))}
  </div>
)}
