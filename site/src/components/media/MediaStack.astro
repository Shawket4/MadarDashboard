---
/**
 * The screens for one area, full size, each with its caption.
 *  - stack (browser or iPad): one under another.
 *  - row (the guest's phones): side by side.
 * An optional floating phone sits over the stack's corner on desktop (the guest's QR
 * order on the floor).
 */
import Shot from "./Shot.astro";
import type { Lang } from "@/lib/site";

export type MediaItem = { id: string; frame: "browser" | "ipad" | "iphone"; alt: string };
interface Props {
  lang: Lang;
  items: MediaItem[];
  layout?: "stack" | "row";
  float?: MediaItem;
  class?: string;
}
const { lang, items, layout = "stack", float, class: cls = "" } = Astro.props;
const sizes = layout === "row" ? "(min-width: 1024px) 14rem, (min-width: 640px) 28vw, 46vw" : "(min-width: 1024px) 50vw, 92vw";
---
<div class:list={["media-stack", cls]} data-media={layout}>
  <div class="media-frame relative">
    <div class="media-track">
      {items.map((it, i) => (
        <figure class="media-card" data-card={i}>
          <Shot id={it.id} lang={lang} alt={it.alt} frame={it.frame} sizes={sizes} />
          <figcaption class="media-caption">{it.alt}</figcaption>
        </figure>
      ))}
    </div>
    {float && (
      <div class="media-float" data-float>
        <Shot id={float.id} lang={lang} alt={float.alt} frame={float.frame} sizes="12rem" />
      </div>
    )}
  </div>
</div>
