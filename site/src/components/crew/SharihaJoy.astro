---
/**
 * شريحة jumping for joy, arms up: the owner's "Not a penny" poster ("Shariha joy"; paths
 * copied from the Illustrator export, not redrawn). The body is its outline only (the
 * export's first contour; the export cut the face out of it), the face drawn on top, as in
 * Shariha.astro. Same rig as the others (styles/sections/crew.css, crew.ts).
 */
interface Props { class?: string }
const { class: cls = "" } = Astro.props;
---
