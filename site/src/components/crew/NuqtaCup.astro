---
/**
 * نقطة raising a coffee cup, steam rising: from the owner's Rue × Madar pickup poster
 * (Illustrator export, paths not redrawn). Same rig as Nuqta.astro (breathes, hops when
 * greeted); the cup arm sips and the steam rises (styles/sections/crew.css). His Ink limbs
 * need a light ground: he stands in a Paper roundel on the Ink door.
 */
interface Props { class?: string }
const { class: cls = "" } = Astro.props;
---
<svg class:list={["crew-figure", cls]} viewBox="0 0 112.31 138.9" aria-hidden="true" data-crew>
  <g class="crew-shadow" style="transform-origin: 52.37px 136.31px"><ellipse cx="52.37" cy="136.31" rx="24.89" ry="2.59" fill="#e1e7e9" /></g>
  <g class="crew-hop" style="transform-origin: 52px 136px">
    <path d="M42.81,102.06c-1.06,11.95-1.86,22.57-2.39,31.86l-7.57,.4" fill="none" stroke="#14181e" stroke-width="5.18" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M61.93,102.06c1.06,11.95,1.86,22.57,2.39,31.86l7.57,.4" fill="none" stroke="#14181e" stroke-width="5.18" stroke-linecap="round" stroke-linejoin="round" />
    <g class="crew-body" style="transform-origin: 52px 134px">
      <g class="crew-arm-rest" style="transform-origin: 19.52px 78.16px"><path d="M19.52,78.16c-8.63,3.32-14.27,8.96-16.93,16.93" fill="none" stroke="#14181e" stroke-width="5.18" stroke-linecap="round" stroke-linejoin="round" /></g>
      <g class="crew-sip" style="transform-origin: 84.63px 66.21px">
        <path d="M84.63,66.21c9.69-7.7,15.2-15.67,16.53-23.9" fill="none" stroke="#14181e" stroke-width="5.18" stroke-linecap="round" stroke-linejoin="round" />
        <g class="crew-steam">
          <path d="M98.37,13.64c-3.19-4.38,3.19-7.57,0-12.74" fill="none" stroke="#0d6273" stroke-width="1.79" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M104.74,13.64c-3.19-4.38,3.19-7.57,0-12.74" fill="none" stroke="#0d6273" stroke-width="1.79" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <polygon points="92,21.21 110.32,21.21 108.33,42.32 93.99,42.32" fill="#fff" stroke="#14181e" stroke-width="1.99" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M90.01,19.22v-.8c0-1.31,1.08-2.39,2.39-2.39h17.52c1.31,0,2.39,1.08,2.39,2.39v.8c0,1.31-1.08,2.39-2.39,2.39H92.4C91.08,21.61,90.01,20.53,90.01,19.22z" fill="#14181e" />
        <polygon points="92.8,28.38 109.52,28.38 108.93,35.15 93.39,35.15" fill="#0d6273" />
      </g>
      <circle cx="52.37" cy="72.19" r="39.83" fill="#0d6273" />
      <path d="M23.04,59.74c3.23-7.6,9.28-13.65,16.88-16.88" fill="none" stroke="#2e94a6" stroke-width="3.98" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M38.08,70.47c3.11-5.59,6.21-5.59,9.32,0M57.34,70.47c3.11-5.59,6.21-5.59,9.32,0" fill="none" stroke="#eff3f4" stroke-width="2.64" stroke-linecap="round" stroke-linejoin="round" />
      <g class="crew-mouth" style="transform-origin: 52px 82px"><path d="M46.16,82.27c0,8.7,12.43,8.7,12.43,0H46.16z" fill="#eff3f4" /></g>
    </g>
  </g>
</svg>
