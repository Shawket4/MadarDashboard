---
import Icon from "@/components/ui/Icon.astro";
import Section from "@/components/kit/Section.astro";
import { t } from "@/i18n";
import { type Lang, whatsappHref, PHONE_HREF, EMAIL_HREF } from "@/lib/site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
---
<Section id="closing" tone="ink" pad="loose" orbit="-end-[28rem] top-1/2 h-[64rem] w-[64rem] -translate-y-1/2 md:-end-[20rem]" kicker={c.closing.kicker} title={c.closing.title} lead={c.closing.body}>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3" data-reveal>
        <a class="btn btn-paper btn-lg" href={whatsappHref(lang)} target="_blank" rel="noopener" data-umami-event="whatsapp" data-umami-event-where="closing">
          {c.closing.cta} <Icon name="arrow" size={18} />
        </a>
        <a class="link-cta" href={PHONE_HREF} data-umami-event="call"><Icon name="phone" size={18} /> {c.closing.call}</a>
        <a class="link-cta" href={EMAIL_HREF} data-umami-event="email"><Icon name="mail" size={18} /> {c.closing.email}</a>
      </div>
      <p class="mt-6 font-mono text-sm tracking-wide text-muted-ink" data-reveal>{c.closing.note}</p>
</Section>
