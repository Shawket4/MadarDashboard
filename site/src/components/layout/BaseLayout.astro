---
import "@/styles/global.css";
import plexLatin600 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-latin-600-normal.woff2?url";
import plexLatin400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-latin-400-normal.woff2?url";
import plexLatin500 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-latin-500-normal.woff2?url";
import plexArabic600 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-600-normal.woff2?url";
import plexArabic400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import ContactSheet from "./ContactSheet.astro";
import StickyWhatsApp, { type StickyAction } from "./StickyWhatsApp.astro";
import ClosingBand from "./ClosingBand.astro";
import { existsSync } from "node:fs";
import path from "node:path";
import bootUrl from "@/scripts/classic/boot.js?url&no-inline";
import { t, dirOf } from "@/i18n";
import { type Lang, type PageKey, LANGS, pageHref, absoluteUrl, otherLang, isEnglishOnly } from "@/lib/site";
import { organization } from "@/lib/schema";

interface Props {
  lang: Lang;
  page: PageKey | "notFound";
  headerTone?: "ink" | "paper";
  closing?: boolean;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** The phones' sticky bar's action, when it isn't WhatsApp. */
  sticky?: StickyAction;
  /** The header button, when it should be a direct action rather than "Talk to us". */
  headerCta?: { href: string; label: string; event: string };
}

const { lang, page, headerTone = "paper", closing = true, noindex = false, jsonLd = [], sticky, headerCta } = Astro.props;
const c = t(lang);
const meta = c.meta[page];
const routable = page !== "notFound";
const canonical = routable ? absoluteUrl(pageHref(lang, page)) : undefined;
// Each page's share card (scripts/og.mjs); the home card until a page has its own.
const ogFile = `${lang}-${routable ? page : "home"}.jpg`;
const ogImage = absoluteUrl(`/og/${existsSync(path.join(process.cwd(), "public/og", ogFile)) ? ogFile : `${lang}-home.jpg`}`);
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID as string | undefined;
const umamiSrc = (import.meta.env.PUBLIC_UMAMI_SRC as string | undefined) ?? "https://cloud.umami.is/script.js";

const ld = [organization(), ...jsonLd];
---
<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <!-- Before anything paints: motion and entrance classes (src/scripts/classic/boot.js). -->
    <script is:inline src={bootUrl}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {routable && (isEnglishOnly(page) ? ["en" as const] : LANGS).map((l) => <link rel="alternate" hreflang={l} href={absoluteUrl(pageHref(l, page as PageKey))} />)}
    {routable && <link rel="alternate" hreflang="x-default" href={absoluteUrl(pageHref("en", page as PageKey))} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={c.meta.siteName} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={c.meta.locale} />
    {!isEnglishOnly(page) && <meta property="og:locale:alternate" content={t(otherLang(lang)).meta.locale} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#14181E" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- The faces the hero sets, so none swaps in (and re-flows it) after the first paint:
         on English pages its three weights, on Arabic pages its two Arabic weights and the
         Latin medium its figures are set in (3,000 جنيه). -->
    {lang === "ar" ? (
      <>
        <link rel="preload" as="font" type="font/woff2" href={plexArabic600} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={plexArabic400} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={plexLatin500} crossorigin />
      </>
    ) : (
      <>
        <link rel="preload" as="font" type="font/woff2" href={plexLatin600} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={plexLatin500} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={plexLatin400} crossorigin />
      </>
    )}

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    {umamiId && <script is:inline defer src={umamiSrc} data-website-id={umamiId} data-domains="get.madar-pos.cloud"></script>}
    <slot name="head" />
  </head>
  <body class="bg-paper text-ink">
    <a class="skip-link" href="#main">{c.nav.skip}</a>
    <Header lang={lang} page={page} tone={headerTone} cta={headerCta} />
    <main id="main">
      <slot />
    </main>
    {closing && <ClosingBand lang={lang} />}
    <Footer lang={lang} page={page} />
    <ContactSheet lang={lang} />
    <StickyWhatsApp lang={lang} action={sticky} />
    <script>
      import "@/scripts/ui";
      import "@/scripts/story";
      import "@/scripts/offline";
    </script>
  </body>
</html>
