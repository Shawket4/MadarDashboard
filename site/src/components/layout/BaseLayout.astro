---
import "@/styles/global.css";
import plexSans600 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url";
import plexSans400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import plexArabic600 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-600-normal.woff2?url";
import plexArabic400 from "@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-400-normal.woff2?url";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import ContactSheet from "./ContactSheet.astro";
import StickyWhatsApp from "./StickyWhatsApp.astro";
import ClosingBand from "./ClosingBand.astro";
import { t, dirOf } from "@/i18n";
import {
  type Lang, type PageKey, LANGS, pageHref, absoluteUrl, otherLang, SITE_URL,
  INSTAGRAM, FACEBOOK, PHONE_E164,
} from "@/lib/site";

interface Props {
  lang: Lang;
  page: PageKey | "notFound";
  headerTone?: "ink" | "paper";
  closing?: boolean;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { lang, page, headerTone = "paper", closing = true, noindex = false, jsonLd = [] } = Astro.props;
const c = t(lang);
const meta = c.meta[page];
const routable = page !== "notFound";
const canonical = routable ? absoluteUrl(pageHref(lang, page)) : undefined;
const ogImage = absoluteUrl(`/og/${lang}-${routable ? page : "home"}.jpg`);
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID as string | undefined;
const umamiSrc = (import.meta.env.PUBLIC_UMAMI_SRC as string | undefined) ?? "https://cloud.umami.is/script.js";

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Madar",
  alternateName: "مدار",
  url: SITE_URL,
  logo: absoluteUrl("/icon-512.png"),
  sameAs: [INSTAGRAM, FACEBOOK],
  contactPoint: [{
    "@type": "ContactPoint",
    telephone: PHONE_E164,
    contactType: "sales",
    areaServed: "EG",
    availableLanguage: ["en", "ar"],
  }],
};
const ld = [org, ...jsonLd];
---
<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function (d) {
        // Hide what the scroll story will animate in, until it's ready (3 s safety net).
        if (window.matchMedia && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          d.classList.add("m");
          setTimeout(function () { if (!d.classList.contains("m-ready")) d.classList.add("m-fail"); }, 3000);
        }
        // Opened as …/index.html: the server couldn't open the folder address and the
        // root page forwarded here. Show the clean address; links go straight to files.
        var p = location.pathname;
        if (/\/index\.html$/.test(p)) {
          d.setAttribute("data-files", "");
          try { history.replaceState(history.state, "", p.slice(0, -10) + location.search + location.hash); } catch (e) {}
        }
      })(document.documentElement);
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {routable && LANGS.map((l) => <link rel="alternate" hreflang={l} href={absoluteUrl(pageHref(l, page as PageKey))} />)}
    {routable && <link rel="alternate" hreflang="x-default" href={page === "home" ? absoluteUrl("/") : absoluteUrl(pageHref("en", page as PageKey))} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={c.meta.siteName} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={c.meta.locale} />
    <meta property="og:locale:alternate" content={t(otherLang(lang)).meta.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#14181E" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {lang === "ar" ? (
      <>
        <link rel="preload" as="font" type="font/woff2" href={plexArabic600} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={plexArabic400} crossorigin />
      </>
    ) : (
      <>
        <link rel="preload" as="font" type="font/woff2" href={plexSans600} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={plexSans400} crossorigin />
      </>
    )}

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    {umamiId && <script is:inline defer src={umamiSrc} data-website-id={umamiId} data-domains="get.madar-pos.cloud"></script>}
    <slot name="head" />
  </head>
  <body class="bg-paper text-ink">
    <a class="skip-link" href="#main">{c.nav.skip}</a>
    <Header lang={lang} page={page} tone={headerTone} />
    <main id="main">
      <slot />
    </main>
    {closing && <ClosingBand lang={lang} />}
    <Footer lang={lang} page={page} />
    <ContactSheet lang={lang} />
    <StickyWhatsApp lang={lang} />
    <script>
      import "@/scripts/ui";
      import "@/scripts/story";
    </script>
  </body>
</html>
