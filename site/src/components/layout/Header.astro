---
import Logo from "@/components/ui/Logo.astro";
import Icon from "@/components/ui/Icon.astro";
import { t, featureGroups, pageLabel } from "@/i18n";
import { PAGES } from "@/lib/pages";
import { type Lang, type PageKey, pageHref, otherLang, switchHref as switchTo, DASHBOARD_URL, whatsappHref } from "@/lib/site";

interface Props {
  lang: Lang;
  page: PageKey | "notFound";
  tone: "ink" | "paper";
  /** Replaces "Talk to us" with a direct action (the Free page: create the account). */
  cta?: { href: string; label: string; event: string };
}
const { lang, page, tone, cta } = Astro.props;
const c = t(lang);
const other = otherLang(lang);
const switchHref = switchTo(lang, page);
// The header's links: the registry's nav pages, in its order (lib/pages.ts).
const links: { key: PageKey; label: string }[] = PAGES.filter((p) => "nav" in p && p.nav).map((p) => ({ key: p.key, label: pageLabel(lang, p.key) }));
---
<header class="vt-header site-header fixed inset-x-0 top-0 z-50" data-tone={tone} data-solid="false">
  <!-- How far down the page you are: filled as it scrolls (scripts/motion.ts); empty without motion. -->
  <span class="page-progress" aria-hidden="true" data-progress></span>
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href={pageHref(lang, "home")} aria-label={c.nav.home} class="flex h-11 items-center text-[1.4rem] md:text-[1.55rem]">
      <Logo lang={lang} tone="paper" class="logo-on-paper" />
      <Logo lang={lang} tone="ink" class="logo-on-ink" />
    </a>

    <nav aria-label={c.nav.primary} class="hidden items-center gap-1 lg:flex">
      {links.map((l) => (
        <a class="nav-link" href={pageHref(lang, l.key)} aria-current={page === l.key ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <a
        class="nav-link lang-switch hidden sm:inline-flex"
        href={switchHref}
        hreflang={other}
        lang={other}
        aria-label={c.nav.langSwitchAria}
        data-umami-event="lang-switch"
      >{c.nav.langSwitch}</a>
      <a class="nav-link hidden md:inline-flex" href={DASHBOARD_URL} rel="noopener">{c.nav.login}</a>
      {cta ? (
        <a class="btn btn-ink btn-sm hidden sm:inline-flex" href={cta.href} data-umami-event={cta.event} data-umami-event-where="header">{cta.label}</a>
      ) : (
        <a
          class="btn btn-ink btn-sm hidden sm:inline-flex"
          href={whatsappHref(lang)}
          data-open-contact
          data-umami-event="talk-to-us"
        >{c.nav.talk}</a>
      )}
      <button type="button" class="nav-link inline-flex h-11 w-11 items-center justify-center !p-0 lg:hidden" data-open-menu aria-haspopup="dialog" aria-controls="mobile-menu" aria-label={c.nav.menu}>
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>

<!-- Phone menu (ui.ts). The current page wears the logo's teal satellite; Features opens
     onto its areas, set out like the café's day the site tells. -->
<dialog id="mobile-menu" class="menu-sheet" aria-label={c.nav.menu} data-lenis-prevent>
  <div class="menu-panel">
    <div class="container-site flex h-16 shrink-0 items-center justify-between">
      <a href={pageHref(lang, "home")} aria-label={c.nav.home} class="flex h-11 items-center text-[1.4rem]"><Logo lang={lang} tone="ink" /></a>
      <button type="button" class="menu-close" data-close-menu aria-label={c.nav.close} autofocus><Icon name="close" size={20} /></button>
    </div>
    <nav aria-label={c.nav.primary} class="container-site mt-3">
      <ul>
        {[{ key: "home" as PageKey, label: c.nav.homeLabel }, ...links].map((l) => (
          <li class="menu-item">
            <div class="menu-row">
              <a class="menu-link" href={pageHref(lang, l.key)} aria-current={page === l.key ? "page" : undefined}>{l.label}</a>
              {l.key === "features" && (
                <button type="button" class="menu-more" aria-expanded="false" aria-controls="menu-areas" aria-label={c.nav.featureAreas}>
                  <Icon name="chevron-down" size={20} />
                </button>
              )}
            </div>
            {l.key === "features" && (
              <div id="menu-areas" class="menu-areas" inert>
                <div class="menu-areas-inner">
                  {featureGroups(lang).map((g) => (
                    <div class="menu-group">
                      <p class="menu-group-label">{g.label}</p>
                      <ul>
                        {g.items.map(([id, label]) => <li><a class="menu-area" href={pageHref(lang, "features", id)}>{label}</a></li>)}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="container-site mt-auto pt-10">
      <a class="btn btn-paper btn-lg w-full" href={whatsappHref(lang)} target="_blank" rel="noopener" data-umami-event="whatsapp" data-umami-event-where="menu">
        {c.contact.whatsapp} <Icon name="arrow" size={18} />
      </a>
      <div class="mt-2 flex items-center justify-between gap-4">
        <a class="menu-quiet" href={DASHBOARD_URL} rel="noopener">{c.nav.login}</a>
        <a class="menu-quiet lang-switch" href={switchHref} hreflang={other} lang={other} data-umami-event="lang-switch"><Icon name="globe" size={18} /> {c.nav.langSwitch}</a>
      </div>
    </div>
  </div>
</dialog>
