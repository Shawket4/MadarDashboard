---
/** Phones only: a slim WhatsApp bar once the hero has scrolled away; hidden over the closing band. */
import Icon from "@/components/ui/Icon.astro";
import { t } from "@/i18n";
import { type Lang, whatsappHref } from "@/lib/site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
---
<div id="sticky-wa" class="sticky-wa fixed inset-x-3 z-40 md:hidden" style="bottom: max(0.75rem, env(safe-area-inset-bottom));" data-visible="false">
  <a class="btn btn-primary btn-lg w-full shadow-xl" href={whatsappHref(lang)} target="_blank" rel="noopener" data-umami-event="whatsapp" data-umami-event-where="sticky">
    <Icon name="whatsapp" /> {c.contact.whatsapp}
  </a>
</div>
