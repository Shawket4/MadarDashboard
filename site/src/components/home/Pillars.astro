---
import { t } from "@/i18n";
import type { Lang } from "@/lib/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
---
<section class="bg-paper" aria-label={c.pillars.label}>
  <div class="container-site py-16 md:py-20">
    <ol class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {c.pillars.items.map((p, i) => (
        <li class="border-t border-ink/15 pt-5" data-reveal>
          <span class="font-mono text-sm text-teal">0{i + 1}</span>
          <h2 class="mt-3 text-lg font-semibold leading-snug">{p.title}</h2>
          <p class="mt-2 text-[0.95rem] text-muted">{p.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
