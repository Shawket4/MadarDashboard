---
/** The home page's four pillars, under the hero: a FeatureGrid in its own section. */
import Section from "@/components/kit/Section.astro";
import FeatureGrid from "@/components/kit/FeatureGrid.astro";
import { t } from "@/i18n";
import type { Lang } from "@/lib/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
---
<Section pad="tight" label={c.pillars.label}>
  <FeatureGrid items={c.pillars.items} columns={4} numbered as="h2" />
</Section>
