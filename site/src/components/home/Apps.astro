---
/**
 * The apps, after the family: where each one is today. Madar Cashier is on the App
 * Store (Apple's badge, the one store link); the kitchen screen, the dashboard and Dawam
 * are coming to both stores, said in words. The dashboard already runs in a browser.
 * Icons are the kits' own app tiles (Madar Design System, Dawam Design System v2).
 */
import Section from "@/components/kit/Section.astro";
import StoreBadges from "@/components/ui/StoreBadges.astro";
import Icon from "@/components/ui/Icon.astro";
import cashier from "@shared/apps/icons/cashier.svg?url";
import kitchen from "@shared/apps/icons/kitchen.svg?url";
import dashboard from "@shared/apps/icons/dashboard.svg?url";
import dawam from "@shared/apps/icons/dawam.svg?url";
import { t } from "@/i18n";
import { type Lang, type AppKey, APP_KEYS, DASHBOARD_URL, isLive, downloadsHref } from "@/lib/site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const a = t(lang).apps;
// Live or coming soon follows the store URLs in APPS (lib/site.ts), nothing here.
const icons: Record<AppKey, string> = { cashier, kitchen, dashboard, dawam };
const live = APP_KEYS.filter(isLive);
const soon = APP_KEYS.filter((k) => !isLive(k));
---
<Section id="apps" tone="ink" split={5} rule kicker={a.kicker} title={a.title} lead={a.body}>
    <div data-reveal>
      {live.map((key, i) => (
        <div class:list={["flex flex-wrap items-center gap-x-6 gap-y-5", i > 0 && "mt-7"]}>
          <img class="app-icon size-16" src={icons[key]} width="64" height="64" alt="" />
          <div class="min-w-0 flex-1 basis-44">
            <p class="text-xl font-semibold">{a.items[key].name}</p>
            <p class="mt-0.5 text-muted-ink">{a.items[key].line}</p>
          </div>
          <StoreBadges lang={lang} app={key} where="home-apps" />
          <a class="link-cta basis-full text-sm" href={downloadsHref(lang, key)} data-umami-event="downloads" data-umami-event-where="home-apps" data-umami-event-app={key}>{a.downloadsLink} <Icon name="arrow" size={14} /></a>
        </div>
      ))}
      <ul class="mt-9 grid gap-x-8 gap-y-7 border-t border-line-ink pt-9 sm:grid-cols-3">
        {soon.map((key) => (
          <li class="flex gap-4 sm:flex-col sm:gap-3">
            <img class="app-icon size-12" src={icons[key]} width="48" height="48" alt="" />
            <div class="min-w-0">
              <p class="font-semibold">{a.items[key].name}</p>
              <p class="mt-0.5 text-sm text-muted-ink">{a.items[key].line}</p>
              <p class="mt-2 text-xs font-medium text-muted-ink">{a.soon}</p>
              <a class="link-cta mt-1 text-sm" href={downloadsHref(lang, key)} data-umami-event="downloads" data-umami-event-where="home-apps" data-umami-event-app={key}>{a.downloadsLink} <Icon name="arrow" size={14} /></a>
              {key === "dashboard" && (
                <a class="link-cta text-sm" href={DASHBOARD_URL} rel="noopener">{a.browser} <Icon name="arrow" size={16} /></a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
</Section>
