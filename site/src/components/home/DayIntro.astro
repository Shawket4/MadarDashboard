---
import Section from "@/components/kit/Section.astro";
import { t } from "@/i18n";
import type { Lang } from "@/lib/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const stages = [
  { key: "opening", ...c.day.stages.opening },
  { key: "rush", ...c.day.stages.rush },
  { key: "close", ...c.day.stages.close },
];
---
<!-- Flows straight into the story's first stage, so it pads itself. -->
<Section id="day" pad="none" class="pb-6 pt-12 md:pt-20" headClass="max-w-4xl" kicker={c.day.kicker} title={c.day.title} lead={c.day.body}>
    <ol class="grid gap-4 sm:grid-cols-3" data-reveal-group>
      {stages.map((s) => (
        <li data-reveal>
          <a href={`#stage-${s.key}`} class="card lift group flex h-full flex-col p-6 hover:border-teal/40">
            <span class="ltr font-mono text-3xl font-medium text-teal">{s.time}</span>
            <span class="mt-3 text-lg font-semibold">{s.name}</span>
            <span class="mt-1.5 text-sm text-muted">{s.line}</span>
          </a>
        </li>
      ))}
    </ol>
</Section>
