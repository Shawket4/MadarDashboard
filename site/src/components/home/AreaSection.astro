---
/**
 * One area of the café's day: the intro and its points beside the screens.
 *
 * With several screens (`media`) the area is a scroll-told scene. Nothing pins: the
 * carousel stays in view (sticky) while the points scroll past it, each point bringing
 * up the screen it goes with (story.ts), so the page always moves under the reader's
 * thumb. Desktop: the words on one side, the carousel on the other. Phones: the intro,
 * then the carousel held under the header while the points scroll beneath it.
 * `stepMap` maps each step to its screen (step 0 is the intro, then one per point);
 * `order` is the screens in the order the paragraph first needs them. Without motion
 * every screen shows, one under another, with its caption.
 */
import Icon from "@/components/ui/Icon.astro";
import MediaStack, { type MediaItem } from "@/components/media/MediaStack.astro";
import { t } from "@/i18n";
import type { Lang } from "@/lib/site";

interface Props {
  lang: Lang;
  id: string;
  kicker: string;
  title: string;
  body: string;
  points: string[];
  stepMap?: number[];
  tone?: "paper" | "ink";
  reverse?: boolean;
  moreHref?: string;
  media?: { items: MediaItem[]; layout?: "stack" | "row"; float?: MediaItem };
}
const { lang, id, kicker, title, body, points, stepMap = [], tone = "paper", reverse = false, moreHref, media } = Astro.props;
const c = t(lang);
const ink = tone === "ink";

// The screens in the order the paragraph first needs them.
const order = media ? [...new Set(stepMap.length ? stepMap : media.items.map((_, i) => i))] : [];
const scene = order.length > 1;
const kickerTone = ink ? "text-teal-light" : "text-teal";
const mutedTone = ink ? "text-muted-ink" : "text-muted";
---
<section
  id={id}
  class:list={["area relative", scene && "area-scene"]}
  data-area
  data-order={scene ? JSON.stringify(order) : undefined}
  aria-labelledby={`${id}-title`}
>
  <div class:list={["area-grid container-site py-16 md:py-24 lg:py-28", reverse && "area-reverse"]}>
    <div class="area-intro area-step" data-step="0" data-screen={stepMap[0] ?? 0}>
      <p class:list={["kicker", kickerTone]}>{kicker}</p>
      <h3 id={`${id}-title`} class="text-h3 mt-4" data-split>{title}</h3>
      <p class:list={["text-lead mt-5", mutedTone]}>{body}</p>
    </div>
    <div class="area-media" data-area-media>
      <div class="area-stick">
        {media ? (
          <MediaStack lang={lang} items={media.items} layout={media.layout} float={media.float} order={order} />
        ) : (
          <slot name="media" />
        )}
      </div>
    </div>
    <ul class="area-points space-y-4">
      {points.map((p, i) => (
        <li class="area-step" data-step={i + 1} data-screen={stepMap[i + 1] ?? 0}>
          <p class:list={["bullet text-[1.02rem]", ink ? "text-paper/90" : "text-ink/85"]}>{p}</p>
        </li>
      ))}
    </ul>
    {moreHref && (
      <a class:list={["area-more inline-flex items-center gap-2 font-medium", kickerTone]} href={moreHref}>
        {c.common.learnMore} <Icon name="arrow" size={18} />
      </a>
    )}
  </div>

  <slot name="after" />
</section>
