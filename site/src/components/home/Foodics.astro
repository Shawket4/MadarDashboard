---
/**
 * "Coming from Foodics?": five steps from a Foodics menu to selling on Madar, beside the
 * scene that plays them (media/FoodicsStage.astro, scripts/foodics.ts). On the home, Free
 * and Features pages, first after the hero (owner, 2026-10-19).
 *  - The scene loops on its own while on screen, the current step lit. The stepper under
 *    it (or a step in the list) plays that step and holds it; its button pauses or plays.
 *  - Reduced motion and no JavaScript: the last frame and every step, no stepper.
 * Each step has an id (foodics-1 …) for the HowTo's steps (lib/schema.ts, foodicsHowTo).
 */
import Section from "@/components/kit/Section.astro";
import FoodicsStage from "@/components/media/FoodicsStage.astro";
import Icon from "@/components/ui/Icon.astro";
import { t } from "@/i18n";
import { type Lang, signupHref } from "@/lib/site";

const pad = (n: number) => String(n).padStart(2, "0");

interface Props { lang: Lang }
const { lang } = Astro.props;
const f = t(lang).foodics;
---
<Section id="foodics" kicker={f.kicker} title={f.title} lead={f.lead}>
  <div class="fx-panel" data-foodics="loop">
    <div class="fx-grid">
      <ol class="fx-steps" data-reveal-group>
        {f.steps.map((s, i) => (
          <li id={`foodics-${i + 1}`} class="fx-step" data-reveal data-fx-step>
            <span class="fx-step-n ltr" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div class="min-w-0">
              <h3 class="fx-step-title">{s.t}</h3>
              <p class="fx-step-body">{s.b}</p>
              {i === 0 && (
                <a class="link-cta fx-step-cta" href={signupHref(lang)} data-umami-event="free-signup" data-umami-event-where="foodics">
                  {f.cta} <Icon name="arrow" size={18} />
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
      <div class="fx-scene" data-reveal>
        <FoodicsStage lang={lang} />
        <div class="fx-stepper" role="group" aria-label={f.stepper} data-fx-stepper data-md-skip hidden>
          <button type="button" class="fx-toggle press" aria-label={f.pause} data-fx-toggle data-pause={f.pause} data-play={f.play}>
            <Icon name="pause" size={18} class="fx-ic-pause" /><Icon name="play" size={18} class="fx-ic-play" />
          </button>
          <ol class="fx-dots">
            {f.steps.map((s, i) => (
              <li><button type="button" class="fx-dot press ltr" aria-label={`${i + 1}. ${s.t}`} data-fx-go={i}>{pad(i + 1)}</button></li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
  <p class="mt-8 max-w-2xl text-xs text-muted">{f.note}</p>
</Section>
