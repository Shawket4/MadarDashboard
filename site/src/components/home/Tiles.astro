---
import Icon from "@/components/ui/Icon.astro";
import { t } from "@/i18n";
import { type Lang, pageHref } from "@/lib/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const tiles = [
  { key: "dawam", a: c.areas.dawam, icon: "clock" as const },
  { key: "setup", a: c.areas.setup, icon: "spark" as const },
];
---
<section class="bg-surface" aria-labelledby="tiles-title">
  <div class="container-site pb-24 pt-6 md:pb-32">
    <h2 id="tiles-title" class="kicker text-teal">{c.tiles.title}</h2>
    <div class="mt-6 grid gap-5 md:grid-cols-2" data-reveal-group>
      {tiles.map(({ key, a, icon }) => (
        <a href={pageHref(lang, "features", key)} class="card group relative overflow-hidden p-7 transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_30px_60px_-30px_rgba(20,24,30,0.35)] md:p-9" data-reveal>
          <span class="grid h-11 w-11 place-items-center rounded-2xl bg-teal/10 text-teal"><Icon name={icon} size={22} /></span>
          <p class="kicker mt-6 text-teal">{a.kicker}</p>
          <h3 class="mt-3 text-2xl font-semibold leading-tight">{a.title}</h3>
          <p class="mt-3 text-muted">{a.body}</p>
          <span class="mt-7 inline-flex items-center gap-2 font-medium text-teal">
            {c.tiles.more} <Icon name="arrow" size={18} class="transition-transform group-hover:translate-x-1" />
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
