---
/**
 * The rush, as a stream of orders from every channel. A CSS-only port of Magic UI's
 * Marquee (MIT): no JavaScript, and it stops under reduced motion.
 */
interface Props { tags: string[] }
const { tags } = Astro.props;
const rows = [tags, [...tags.slice(5), ...tags.slice(0, 5)]];
---
<div class="relative mt-14 space-y-3 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]" aria-hidden="true">
  {rows.map((row, r) => (
    <div class="flex gap-(--gap) overflow-hidden [--duration:56s] [--gap:0.75rem]" style={r === 1 ? "--duration:64s" : ""}>
      {[0, 1].map(() => (
        <div class="marquee-track flex shrink-0 animate-marquee gap-(--gap)" style={r === 1 ? "animation-direction: reverse" : ""}>
          {row.map((tag) => (
            <span class="chip chip-tag whitespace-nowrap border border-line-ink bg-ink-2 text-paper/85">
              <span class="h-1.5 w-1.5 rounded-full bg-teal-light"></span>{tag}
            </span>
          ))}
        </div>
      ))}
    </div>
  ))}
</div>
