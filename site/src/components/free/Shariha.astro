---
/**
 * شريحة (Shariha), the reports: a slice of the sales chart. The owner's artwork (paths
 * copied from the export, not redrawn), with the body as its outline only (the export
 * cut the face out of it, which would show the page through the eyes when they blink),
 * and the parts grouped for the crew's motion (global.css "The crew", crew.ts).
 */
interface Props { class?: string }
const { class: cls = "" } = Astro.props;
