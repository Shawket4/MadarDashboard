---
/**
 * "One ledger under everything": every surface writes to the same ledger, and
 * every report reads from it. The nodes are plain HTML; `scripts/beams.ts` draws
 * the beams between them (curves measured from where the nodes sit) and sends a
 * light along each one, on screen only. Under reduced motion the beams are still
 * drawn, without the light; without JavaScript the nodes stand on their own.
 * (Rebuilt without React from the Magic UI AnimatedBeam it began as, MIT.)
 */
interface Props {
  labels: {
    till: string;
    ordering: string;
    inventory: string;
    loyalty: string;
    ledger: string;
    dashboard: string;
    exports: string;
    basira: string;
  };
}
const { labels } = Astro.props;

const ICONS: Record<string, string> = {
  till: "M4 7h16v10H4zM8 7V4h8v3M8 12h3",
  inventory: "M4 8l8-4 8 4v8l-8 4-8-4zM4 8l8 4 8-4M12 12v8",
  ordering: "M8 3h8a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM11 18h2",
  loyalty: "M4 7h16v10H4zM4 11h16M8 15h2",
  dashboard: "M4 5h16v14H4zM8 15v-3M12 15V9M16 15v-5",
  exports: "M6 3h9l3 3v15H6zM9 13h6M9 17h6M9 9h3",
  basira: "M5 5h14v10H9l-4 4zM9 10h6",
};
const inputs = ["till", "ordering", "inventory", "loyalty"] as const;
const outputs = ["dashboard", "exports", "basira"] as const;
const node = "relative z-10 flex items-center gap-2.5 rounded-2xl border border-ink/10 bg-white px-3.5 py-2.5 text-sm font-medium text-ink shadow-sm";
---
<div class="relative mx-auto grid w-full max-w-5xl grid-cols-[1fr_auto_1fr] items-center gap-6 sm:gap-10 md:gap-16" data-beams>
  <svg class="pointer-events-none absolute inset-0 size-full overflow-visible" aria-hidden="true" data-beam-svg></svg>
  <div class="flex flex-col items-start gap-3">
    {inputs.map((k) => (
      <div class={node} data-beam-node={k}>
        <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-teal" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={ICONS[k]} />
        </svg>
        <span>{labels[k]}</span>
      </div>
    ))}
  </div>
  <div
    class="relative z-10 flex flex-col items-center gap-2 rounded-2xl border border-teal/30 bg-ink px-6 py-5 text-sm font-medium text-paper shadow-[0_20px_50px_-20px_rgba(13,98,115,0.8)]"
    data-beam-node="ledger"
  >
    <svg viewBox="0 0 100 100" class="h-12 w-12" aria-hidden="true">
      <circle cx="50" cy="50" r="34" stroke="#EFF3F4" stroke-width="6.5" fill="none" />
      <circle cx="50" cy="50" r="12" fill="#EFF3F4" />
      <circle cx="74.04" cy="25.96" r="8" fill="#0D6273" />
    </svg>
    <span>{labels.ledger}</span>
  </div>
  <div class="flex flex-col items-end gap-3">
    {outputs.map((k) => (
      <div class={node} data-beam-node={k}>
        <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-teal" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d={ICONS[k]} />
        </svg>
        <span>{labels[k]}</span>
      </div>
    ))}
  </div>
</div>

<script>
  import "@/scripts/beams";
</script>
