---
/**
 * Questions and answers as native <details> (no script; the first one open), each rising
 * as it scrolls in. The FAQ page and the Free page use it; their FAQPage JSON-LD comes
 * from the same items (faqPage() in lib/schema.ts).
 */
interface Props { items: readonly { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="divide-y divide-ink/10 border-y border-ink/10" data-reveal-group>
  {items.map((item, i) => (
    <details class="faq-item group" open={i === 0} data-reveal>
      <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 py-6 text-lg font-semibold leading-snug marker:hidden [&::-webkit-details-marker]:hidden">
        <span>{item.q}</span>
        <span class="mt-1 grid h-7 w-7 shrink-0 place-items-center rounded-full border border-rule text-teal transition-transform duration-300 group-open:rotate-45">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        </span>
      </summary>
      <p class="max-w-2xl pb-7 text-muted">{item.a}</p>
    </details>
  ))}
</div>
