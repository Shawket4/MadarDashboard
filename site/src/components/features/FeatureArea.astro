---
/**
 * One area on the features page: its words and what it carries (a CheckList) in a column
 * that holds still while its screens scroll by beside it (a Section, split and sticky).
 */
import Section from "@/components/kit/Section.astro";
import CheckList from "@/components/kit/CheckList.astro";
import Shot from "@/components/media/Shot.astro";
import MediaStack from "@/components/media/MediaStack.astro";
import type { Lang } from "@/lib/site";

type ShotRef = { id: string; frame: "browser" | "ipad" | "iphone"; alt: string };
interface Props {
  lang: Lang;
  id: string;
  kicker: string;
  title: string;
  body: string;
  points: string[];
  more?: string[];
  shots?: ShotRef[];
  tone?: "paper" | "surface";
  [extra: string]: unknown;
}
const { lang, id, kicker, title, body, points, more = [], shots = [], tone = "paper" } = Astro.props;
const all = [...points, ...more];
const phones = shots.filter((s) => s.frame === "iphone");
const wide = shots.filter((s) => s.frame !== "iphone");
---
<Section id={id} titleId={`f-${id}-title`} tone={tone} pad="tight" split={5} sticky size="h3" kicker={kicker} title={title} lead={body} class="scroll-mt-32 [--sticky-top:9rem]">
  <CheckList slot="head" class="mt-8" items={all} />
  <div class="flex flex-col gap-10">
    <slot />
    {/* Two screens or more: the set pins (not the section, whose words can be taller
        than the screen) while scrolling turns its screens (story.ts, carousel.ts). The
        wrapper is what pins, so the set's own entrance stays on the set. */}
    {wide.length > 1 && <div data-pin-set><MediaStack lang={lang} items={wide} layout="strip" mode="pass" data-reveal="" /></div>}
    {wide.length === 1 && wide[0] && (
      <Shot id={wide[0].id} lang={lang} alt={wide[0].alt} frame={wide[0].frame} sizes="(min-width: 1024px) 50vw, 92vw" data-reveal="" />
    )}
    {phones.length > 1 && <div data-pin-set><MediaStack lang={lang} items={phones} layout="fan" mode="pass" data-reveal="" /></div>}
    {phones.length === 1 && phones[0] && (
      <div class="grid grid-cols-2 gap-5 sm:grid-cols-3">
        <Shot id={phones[0].id} lang={lang} alt={phones[0].alt} frame="iphone" sizes="(min-width: 1024px) 14rem, (min-width: 640px) 30vw, 45vw" data-reveal="" />
      </div>
    )}
  </div>
</Section>
