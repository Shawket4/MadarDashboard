---
import Shot from "@/components/media/Shot.astro";
import Icon from "@/components/ui/Icon.astro";
import type { Lang } from "@/lib/site";

type ShotRef = { id: string; frame: "browser" | "ipad" | "iphone"; alt: string };
interface Props {
  lang: Lang;
  id: string;
  kicker: string;
  title: string;
  body: string;
  points: string[];
  more?: string[];
  shots?: ShotRef[];
  tone?: "paper" | "surface";
  [extra: string]: unknown;
}
const { lang, id, kicker, title, body, points, more = [], shots = [], tone = "paper" } = Astro.props;
const all = [...points, ...more];
const phones = shots.filter((s) => s.frame === "iphone");
const wide = shots.filter((s) => s.frame !== "iphone");
---
<section id={id} class:list={["scroll-mt-32", tone === "surface" ? "bg-surface" : "bg-paper"]} aria-labelledby={`f-${id}-title`}>
  <div class="container-site grid gap-10 py-16 md:py-24 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-36">
        <p class="kicker text-teal" data-reveal>{kicker}</p>
        <h2 id={`f-${id}-title`} class="text-h3 mt-4" data-split>{title}</h2>
        <p class="text-lead mt-5 text-muted" data-reveal>{body}</p>
        <ul class="mt-8 space-y-3.5" data-reveal-group>
          {all.map((p) => (
            <li class="flex gap-3" data-reveal>
              <span class="mt-1 text-teal"><Icon name="check" size={18} /></span>
              <span class="text-ink/85">{p}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="flex flex-col gap-6 lg:col-span-7">
      <slot />
      {wide.length > 0 && (
        <div class:list={["grid gap-6", wide.length > 1 && "sm:grid-cols-2"]}>
          {wide.map((s, i) => (
            <Shot
              id={s.id}
              lang={lang}
              alt={s.alt}
              frame={s.frame}
              class={wide.length > 2 && i === 0 ? "sm:col-span-2" : ""}
              sizes={wide.length > 2 && i === 0 ? "(min-width: 1024px) 50vw, 92vw" : "(min-width: 1024px) 25vw, (min-width: 640px) 46vw, 92vw"}
              data-reveal=""
            />
          ))}
        </div>
      )}
      {phones.length > 0 && (
        <div class="grid grid-cols-2 gap-5 sm:grid-cols-3">
          {phones.map((s) => (
            <Shot id={s.id} lang={lang} alt={s.alt} frame="iphone" sizes="(min-width: 1024px) 14rem, (min-width: 640px) 30vw, 45vw" data-reveal="" />
          ))}
        </div>
      )}
    </div>
  </div>
</section>
